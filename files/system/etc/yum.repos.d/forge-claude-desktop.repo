# Claude Desktop, repackaged as .rpm by the claude-desktop-debian project from Anthropic's
# official Linux app. The signing key is checked against a pinned fingerprint at build time
# (files/scripts/pin-repo-keys.sh), so dnf only trusts that exact key.
[claude-desktop-unofficial]
name=Claude Desktop (unofficial packaging) for Fedora/RHEL
baseurl=https://pkg.claude-desktop-debian.dev/rpm/$basearch
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/forge-claude-desktop.gpg
metadata_expire=1h
