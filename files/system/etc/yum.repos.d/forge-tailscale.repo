# Tailscale. The signing key is checked against a pinned fingerprint at build time
# (files/scripts/pin-repo-keys.sh), so dnf only trusts that exact key.
[tailscale-stable]
name=Tailscale stable
baseurl=https://pkgs.tailscale.com/stable/fedora/$basearch
enabled=1
type=rpm
repo_gpgcheck=1
gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/forge-tailscale.gpg
