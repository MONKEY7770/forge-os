#!/usr/bin/env bash
# forge-health: quick self check, run by a timer (interval set in Forge Settings).
# Writes to ~/.local/state/forge/health.log and shows a desktop
# notification only when something needs attention.
set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/forge"
LOG="$STATE_DIR/health.log"
mkdir -p "$STATE_DIR"
cfg() { forge-config get "$1"; }
VIEWER_TOKEN=${FORGE_VIEWER_TOKEN:-/etc/forge/viewer.token}
HW_NOTICE=${FORGE_HW_NOTICE:-/var/lib/forge-hw/hardware-notice.json}

# Desktop notification. The text is escaped so it can't add links or formatting,
# and "--" stops a message that starts with "-" being read as an option.
notify() {
  local urgency=$1 summary body
  command -v notify-send >/dev/null || return 0
  summary=$(python3 -c 'import html,sys; sys.stdout.write(html.escape(sys.argv[1]))' "$2")
  body=$(python3 -c 'import html,sys; sys.stdout.write(html.escape(sys.argv[1]))' "$3")
  notify-send -u "$urgency" -- "$summary" "$body"
}

GPU_WARN=$(cfg monitor.gpu_temp_warn)
DISK_WARN=$(cfg monitor.disk_warn_pct)
MEM_WARN=$(cfg monitor.mem_warn_gb)
problems=()

# Failed system services
failed=$(systemctl --failed --no-legend --plain 2>/dev/null | awk '{print $1}' | xargs)
[ -n "$failed" ] && problems+=("Failed services: $failed")

# Disk space
while read -r use mount; do
  [ "${use%\%}" -ge "$DISK_WARN" ] && problems+=("Disk $mount is $use full")
done < <(df -h --output=pcent,target -x tmpfs -x devtmpfs -x overlay 2>/dev/null | tail -n +2)

# GPU temperature and VRAM
if command -v nvidia-smi >/dev/null; then
  read -r temp used total < <(nvidia-smi --query-gpu=temperature.gpu,memory.used,memory.total \
    --format=csv,noheader,nounits 2>/dev/null | tr -d ',')
  [ -n "${temp:-}" ] && [ "$temp" -ge "$GPU_WARN" ] && problems+=("GPU is hot: ${temp}C")
  gpu_line="gpu=${temp:-?}C vram=${used:-?}/${total:-?}MB"
fi

# Memory
mem_avail=$(awk '/MemAvailable/ {print int($2/1024/1024)}' /proc/meminfo)
[ "$mem_avail" -lt "$MEM_WARN" ] && problems+=("Low memory: ${mem_avail} GB free")

# Ollama (only if it's turned on)
if [ "$(cfg ai.ollama)" = "on" ] && [ "$(cfg monitor.check_ollama)" = "on" ]; then
  systemctl is-active --quiet ollama || problems+=("Ollama is not running")
fi

# Hardware changes found at boot (shown once per user)
# A notice still "pending" is waiting for its re-apply: shown on a later run, or after
# 15 minutes anyway (the re-apply was stopped), or at once if its time is in the future
# (the clock was wrong when it was written).
hw_pending=$(python3 -c 'import json,sys,time; n=json.load(open(sys.argv[1])); print(n.get("pending") is True and 0 <= time.time() - n.get("ts", 0) < 900)' "$HW_NOTICE" 2>/dev/null)
if [ -r "$HW_NOTICE" ] && [ "$HW_NOTICE" -nt "$STATE_DIR/hw-seen" ] && [ "$hw_pending" != "True" ]; then
  hw_msg=$(python3 -c 'import json,sys; print("\n".join(json.load(open(sys.argv[1]))["changes"]))' "$HW_NOTICE" 2>/dev/null)
  # Older notices have no "reapplied": they were always written after a re-apply.
  reapplied=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("reapplied", True) is not False)' "$HW_NOTICE" 2>/dev/null)
  if [ -n "$hw_msg" ]; then
    echo "$(date -Is) HARDWARE ${hw_msg//$'\n'/; }" >> "$LOG"
    if [ "$reapplied" = "False" ]; then
      notify normal "Forge OS: please check your setup" "$hw_msg
Run forge-doctor for the full report."
    else
      notify normal "Forge OS: hardware changed" "$hw_msg
Settings were re-applied to match."
    fi
  fi
  touch "$STATE_DIR/hw-seen"
fi

# Agent messages and approvals waiting for you. Uses only the read-only viewer token.
if [ "$(cfg core.enabled)" = "on" ] && [ -r "$VIEWER_TOKEN" ] && command -v notify-send >/dev/null; then
  export FORGE_API_VIEWER=1
  seen=$(cat "$STATE_DIR/notices-seen" 2>/dev/null || echo 0)
  forge-api GET "/api/notices?since=$seen" 2>/dev/null | python3 -c '
import html, json, subprocess, sys
items = json.load(sys.stdin) if sys.stdin.readable() else []
for i in items[-5:]:
    # Escaped, so an agent cannot put links or formatting in a notification.
    subprocess.run(["notify-send", "-u", "normal", "--", "Forge agent", html.escape(i["message"])])
print(max([i["ts"] for i in items], default=int(sys.argv[1])))' "$seen" > "$STATE_DIR/notices-seen.tmp" 2>/dev/null \
    && mv "$STATE_DIR/notices-seen.tmp" "$STATE_DIR/notices-seen"
  pending=$(forge-api GET "/api/approval-count" 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin)["pending"])' 2>/dev/null)
  if [ -n "$pending" ] && [ "$pending" -gt 0 ]; then
    notify critical "Forge: $pending agent action(s) need your OK" "Open http://127.0.0.1:$(cfg core.port)/docs or run: sudo forge-api GET /api/approvals"
  fi
fi

# System updates: shown once when one is ready, once per failed update, once per rollback boot.
# rpm-ostree and systemctl are read without root (see forgecore/updates.py).
if [ "$(cfg monitor.notify_updates)" = "on" ]; then
  { read -r up_staged; read -r up_version; read -r up_failed; read -r up_rolled; read -r up_booted; } < <(
    python3 "${FORGE_LIB:-/usr/lib/forge}/forgecore/updates.py" --summary 2>/dev/null | python3 -c '
import json, sys
s = json.load(sys.stdin)
print("\n".join(str(s.get(k) or "") for k in ("staged", "staged_version", "failed", "rolled_back", "booted_version")))' 2>/dev/null)
  if [ -n "${up_staged:-}" ] && [ "$up_staged" != "$(cat "$STATE_DIR/update-ready-seen" 2>/dev/null)" ]; then
    echo "$(date -Is) UPDATE ready ${up_version:-}" >> "$LOG"
    notify normal "Forge OS: update ready" "Version ${up_version:-?} is downloaded. Restart to update."
    echo "$up_staged" > "$STATE_DIR/update-ready-seen"
  fi
  if [ -n "${up_failed:-}" ] && [ "$up_failed" != "$(cat "$STATE_DIR/update-failed-seen" 2>/dev/null)" ]; then
    echo "$(date -Is) UPDATE failed ${up_failed}" >> "$LOG"
    notify normal "Forge OS: the last update failed" "Your PC keeps running the version it has. Try again with: ujust update
Details: journalctl -u ${up_failed%%@*}"
    echo "$up_failed" > "$STATE_DIR/update-failed-seen"
  fi
  if [ -n "${up_rolled:-}" ] && [ "$up_rolled" != "$(cat "$STATE_DIR/update-rollback-seen" 2>/dev/null)" ]; then
    echo "$(date -Is) UPDATE rollback ${up_booted:-}" >> "$LOG"
    notify normal "Forge OS: running an older version" "This PC started an older system version (${up_booted:-?}), so the newest update is not in use.
If that was not on purpose, see: forge-api GET /api/system/updates"
    echo "$up_rolled" > "$STATE_DIR/update-rollback-seen"
  fi
fi

# Log every run, notify only on problems
# Each problem is shown once (numbers such as temperatures may change), not every 10 minutes: only a
# problem not shown before brings the alert back. A healthy run forgets what was shown.
SHOWN="$STATE_DIR/health-shown"
if [ ${#problems[@]} -eq 0 ]; then
  echo "$(date -Is) ok ${gpu_line:-} mem_free=${mem_avail}G" >> "$LOG"
  rm -f "$SHOWN"
else
  msg=$(printf '%s\n' "${problems[@]}")
  echo "$(date -Is) PROBLEM ${msg//$'\n'/; }" >> "$LOG"
  kinds=$(printf '%s\n' "${problems[@]}" | sed 's/[0-9][0-9]*/N/g' | sort -u)
  if [ "$(cfg monitor.notify)" = "on" ] && [ -n "$(comm -23 <(printf '%s\n' "$kinds") <(sort -u "$SHOWN" 2>/dev/null))" ]; then
    notify critical "Forge OS health" "$msg"
    printf '%s\n' "$kinds" | sort -u - "$SHOWN" 2>/dev/null > "$SHOWN.tmp" || printf '%s\n' "$kinds" > "$SHOWN.tmp"
    mv "$SHOWN.tmp" "$SHOWN"
  fi
fi

# Keep the log small
tail -n 5000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"

# Share mode changes and problems with the activity timeline (Forge Core can't read your home folder).
PUBLISH=${FORGE_ACTIVITY_PUBLISH:-/usr/libexec/forge-activity-publish}
if [ -x "$PUBLISH" ]; then
  "$PUBLISH" >/dev/null 2>&1 || true
fi
