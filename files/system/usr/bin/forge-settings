<script nonce="__NONCE__">
const TOKEN = "__TOKEN__";
const H = {"X-Forge-Token": TOKEN, "Content-Type": "application/json"};
const $ = q => document.querySelector(q);
function el(tag, text, cls) { const e = document.createElement(tag); if (text) e.textContent = text; if (cls) e.className = cls; return e; }
applyStatic();
const MARK = {ok: "dash.mark.ok", warn: "dash.mark.warn", info: "dash.mark.info", unknown: "dash.mark.unknown"};

async function report() {
  const box = $("#report");
  try {
    const r = await fetch("/api/doctor", {headers: H});
    const d = await r.json();
    if (!r.ok) throw new Error(d.error || "failed");
    box.textContent = "";
    for (const s of d.sections) {
      const h = el("h3", tr(s.name) + ": ");
      h.appendChild(el("span", MARK[s.status] ? t(MARK[s.status]) : s.status, s.status));
      box.appendChild(h);
      const ul = el("ul");
      for (const item of s.items) ul.appendChild(el("li", tr(item)));
      box.appendChild(ul);
    }
  } catch (e) {
    box.textContent = t("welcome.report_failed");
  }
}

let values = null;
async function load() {
  const r = await fetch("/api/settings", {headers: H});
  values = (await r.json()).values;
  document.querySelectorAll("[data-key]").forEach(c => { c.checked = !!values[c.dataset.key]; });
  $("#save").disabled = false;
}

$("#save").onclick = async () => {
  // Only these settings are sent, as a merge, so a change made elsewhere meanwhile is kept.
  const next = {};
  document.querySelectorAll("[data-key]").forEach(c => { next[c.dataset.key] = c.checked; });
  $("#save").disabled = true; $("#save").textContent = t("ui.saving");
  const out = $("#out"); out.style.display = "block";
  try {
    const r = await fetch("/api/save", {method: "POST", headers: H, body: JSON.stringify({values: next, merge: true})});
    const d = await r.json();
    out.textContent = (d.ok ? t("ui.saved") : t("ui.not_saved")) + "\n" + (d.output ? tr(d.output) : "");
  } catch (e) {
    out.textContent = t("welcome.closed");
  }
  $("#save").disabled = false; $("#save").textContent = t("ui.save");
};

document.querySelectorAll("[data-copy]").forEach(b => b.onclick = async () => {
  try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = t("welcome.copied"); }
  catch (e) { b.textContent = t("welcome.select_copy"); }
});

$("#dash").onclick = async () => {
  const r = await fetch("/api/open-dashboard", {method: "POST", headers: H, body: "{}"}).catch(() => null);
  $("#dash").textContent = r && r.ok && (await r.json()).ok ? t("ui.dash.opening") : t("ui.dash.failed");
};

setInterval(() => fetch("/api/ping", {headers: H}), 30000);
report(); load();
</script>
</body>
