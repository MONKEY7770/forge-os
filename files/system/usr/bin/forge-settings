#!/usr/bin/env python3
"""Forge Settings: one place to see and change every Forge OS option.

Opens a local page in your browser. It only listens on this PC
(127.0.0.1) and needs a secret token, so no other device or website
can use it. It also checks that every request comes from a program
running as you, so other users on this PC can't use it either.
It closes itself a couple of minutes after you close the tab.
"""
import errno
import html
import ipaddress
import json
import os
import re
import secrets
import stat
import subprocess
import sys
import tempfile
import threading
import time
import urllib.parse
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.environ.get("FORGE_LIB", "/usr/lib/forge"))
import forgecfg  # noqa: E402
import forgedash  # noqa: E402
import forgeappearance  # noqa: E402
import forgerelease  # noqa: E402
import forgei18n  # noqa: E402
import forgepresets  # noqa: E402

APPLY = os.environ.get("FORGE_APPLY", "/usr/libexec/forge-apply")
TOKEN = secrets.token_urlsafe(24)
# One-time key in the launch URL. The page is only served to a request that
# carries it. The browser gets it through a private page (launch_page()), never
# on a command line, which any local user could read from /proc/<pid>/cmdline.
# What stops other users is the owner check in peer_uids().
LAUNCH_KEY = secrets.token_urlsafe(24)
LAUNCH_PAGE = None              # that private page's path, removed once the page is served
# Where the kernel lists open TCP sockets. Tests point this at fake files.
PROC_NET = "/proc/net"
last_seen = time.time()
page_served = False
page_lock = threading.Lock()
WELCOME = False                 # --welcome: serve the first-boot welcome page instead
WELCOME_ONCE = False            # --welcome-once: record that it was shown once it is served
DASHBOARD = False               # --dashboard: serve the Forge Dashboard (home screen) instead
DASH = None                     # forgedash.Dashboard, only in dashboard mode
# Scripts and styles on the dashboard page only run with this per-start nonce (see end_headers).
NONCE = secrets.token_urlsafe(18)
DASH_BODY_MAX = 64 * 1024
# Appearance: a second key only for reading your media files in <img> and <video> tags, which can't send
# the token header. It is in the page, like the token, and only works for the owner (same checks).
MEDIA_KEY = secrets.token_urlsafe(24)
LOOK_BODY_MAX = 64 * 1024
# Preview scripts for the Appearance page that later parts of Forge OS add: <section id>.js in here.
PREVIEW_DIR = os.environ.get("FORGE_APPEARANCE_PREVIEWS", "/usr/share/forge/appearance-preview")
PREVIEW_MAX = 256 * 1024
doctor_lock = threading.Lock()
doctor_last = {"at": None, "report": None}


def run_apply(args):
    cmd = [APPLY] + args
    if os.geteuid() != 0:
        cmd = ["pkexec"] + cmd
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode == 126 or r.returncode == 127 and "pkexec" in cmd:
        return False, "Cancelled: password was not entered."
    return r.returncode == 0, (r.stdout + r.stderr).strip()


def save(values, merge=False, switch=None):
    with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
        json.dump(values, f)
        tmp = f.name
    os.chmod(tmp, 0o644)
    try:
        # switch: the update channel the user confirmed on the page (forge-apply switches, then saves).
        return run_apply(["--import", tmp] + (["--merge"] if merge else [])
                         + (["--switch-channel", switch, "--confirm"] if switch else []))
    finally:
        os.unlink(tmp)


def _addr(hexaddr):
    # /proc prints each 32-bit word in the machine's byte order.
    raw = bytes.fromhex(hexaddr)
    if sys.byteorder == "little":
        raw = b"".join(raw[i:i + 4][::-1] for i in range(0, len(raw), 4))
    ip = ipaddress.ip_address(raw)
    return getattr(ip, "ipv4_mapped", None) or ip


def peer_sockets(client, server):
    """Owners of the client sockets for exactly this connection: client (ip, port) to server (ip, port).

    Matching the full addresses matters: another user can bind a different local address with
    the same port number as the owner's browser.
    """
    client = (ipaddress.ip_address(client[0]), int(client[1]))
    server = (ipaddress.ip_address(server[0]), int(server[1]))
    client = (getattr(client[0], "ipv4_mapped", None) or client[0], client[1])
    server = (getattr(server[0], "ipv4_mapped", None) or server[0], server[1])
    uids = []
    for name in ("tcp", "tcp6"):
        try:
            with open(os.path.join(PROC_NET, name)) as f:
                lines = f.readlines()[1:]
        except OSError:
            continue
        for line in lines:
            parts = line.split()
            try:
                local, remote, state, uid = parts[1], parts[2], parts[3], int(parts[7])
                lip, lport = local.split(":")
                rip, rport = remote.split(":")
                if state in ("06", "0A"):
                    continue  # closed (TIME_WAIT) or listening sockets
                if ((_addr(lip), int(lport, 16)), (_addr(rip), int(rport, 16))) != (client, server):
                    continue
            except (IndexError, ValueError):
                continue
            uids.append(uid)
    return uids


def peer_uids(client_port, server_port):
    """Owners of loopback client sockets from client_port to server_port (kept for older callers)."""
    lo = "127.0.0.1"
    return set(peer_sockets((lo, client_port), (lo, server_port)))


def owner_connection(client_address, server_address):
    """True only for exactly one loopback connection whose client socket is ours."""
    try:
        if not ipaddress.ip_address(client_address[0]).is_loopback:
            return False
        uids = peer_sockets(client_address[:2], server_address[:2])
    except ValueError:
        return False
    return uids == [os.getuid()]


class Handler(BaseHTTPRequestHandler):
    # A connection that sends nothing for this long is closed, so nobody can hold threads open.
    timeout = float(os.environ.get("FORGE_CONN_TIMEOUT_S", "10"))

    def log_message(self, *a):
        pass

    def end_headers(self):
        # Every response, including the server's own error pages: no other web page may show
        # this one inside a frame (clickjacking).
        self.send_header("X-Frame-Options", "DENY")
        if getattr(self, "csp", None):
            self.send_header("Content-Security-Policy", self.csp)   # a media file: its own, stricter policy
        elif DASHBOARD:
            # Stricter for the dashboard: nothing from outside this PC, no inline code without the nonce.
            self.send_header("Content-Security-Policy",
                             f"default-src 'none'; script-src 'nonce-{NONCE}'; style-src 'nonce-{NONCE}'; "
                             "connect-src 'self'; img-src data: blob:; base-uri 'none'; form-action 'none'; "
                             "frame-ancestors 'none'")
        else:
            # The settings and welcome pages: the same, plus your own media files for the Appearance previews.
            self.send_header("Content-Security-Policy",
                             f"default-src 'none'; script-src 'nonce-{NONCE}'; style-src 'nonce-{NONCE}'; "
                             "connect-src 'self'; img-src 'self' data: blob:; media-src 'self'; base-uri 'none'; "
                             "form-action 'none'; frame-ancestors 'none'")
        super().end_headers()

    def send(self, code, body, ctype="application/json"):
        data = body.encode() if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def authed(self):
        return secrets.compare_digest(self.headers.get("X-Forge-Token", ""), TOKEN)

    def host_ok(self):
        # Blocks "DNS rebinding": a web page pretending to be 127.0.0.1 under its own name.
        return self.headers.get("Host", "") == f"127.0.0.1:{self.server.server_address[1]}"

    def peer_ok(self):
        return owner_connection(self.client_address, self.server.server_address)

    def allowed(self):
        return self.host_ok() and self.peer_ok()

    def do_GET(self):
        global last_seen, page_served
        if not self.allowed():
            return self.send(403, "{}")
        path, _, query = self.path.partition("?")
        if path != "/" and self.authed():
            # Only requests that passed the token check keep the page alive: any web page in your
            # browser can send the others.
            last_seen = time.time()
        if path == "/":
            # The page carries the secret token, so it is handed out once, to the browser
            # that opened it with the launch key. Anything asking later gets nothing.
            key = urllib.parse.parse_qs(query).get("k", [""])[0]
            name = "Forge Dashboard" if DASHBOARD else "Forge Settings"
            with page_lock:
                if page_served:
                    return self.send(403, f"{name} is already open in a browser tab. "
                                          f"Close it and open {name} again.", "text/plain")
                if not secrets.compare_digest(key.encode(), LAUNCH_KEY.encode()):
                    return self.send(403, f"Open {name} from the app menu.", "text/plain")
                page_served = True  # the launch key is used up now
                last_seen = time.time()
                forget_launch_page()
                if WELCOME_ONCE:
                    mark_welcome_shown()
            if DASHBOARD:
                return self.send(200, dashboard_page(), "text/html; charset=utf-8")
            if WELCOME:
                return self.send(200, WELCOME_PAGE.replace("__TOKEN__", TOKEN).replace("__NONCE__", NONCE)
                                 .replace("<!--__I18N__-->", i18n_block(), 1), "text/html; charset=utf-8")
            self.send(200, settings_page(), "text/html; charset=utf-8")
        elif self.path == "/api/ping" and self.authed():
            self.send(200, "{}")
        elif path == "/api/i18n" and self.authed():
            # The text tables for the page, in your language (Thai or English).
            self.send(200, json.dumps(forgei18n.page_data(forgei18n.language())))
        elif DASHBOARD:
            # The dashboard only reads; the settings endpoints below don't exist in this mode.
            self.dash_get(path)
        elif path.startswith("/api/appearance") and not WELCOME:
            self.look_get(path, query)
        elif path.startswith("/appearance-preview/") and not WELCOME:
            self.preview_get(path)
        elif self.path == "/api/settings" and self.authed():
            schema = forgecfg.load_schema()
            self.send(200, json.dumps({
                "schema": schema,
                "values": forgecfg.values(schema),
                "file": forgecfg.OVERRIDES_PATH,
                "can_undo": os.path.exists(forgecfg.OVERRIDES_PATH + ".bak"),
                "forge_version": forgerelease.version_text(forgerelease.read_version()),
            }))
        elif path == "/api/export" and self.authed():
            # Export button: the same file as forge-config export (portable leaves out this PC's own settings).
            schema = forgecfg.load_schema()
            clean, errors = forgecfg.validate(forgecfg.values(schema), schema)
            if errors:
                return self.send(200, json.dumps({"error": "\n".join(errors)}))
            when = time.strftime(forgecfg.TIME_FORMAT, time.gmtime())
            self.send(200, json.dumps(forgecfg.export_doc(clean, schema, query == "portable=1", forgecfg.this_host(),
                                                          forgecfg.image_name(), when)))
        elif self.path == "/api/doctor" and self.authed():
            report = doctor_report()
            self.send(200 if report else 500, json.dumps(report or {"error": "The report could not be built. "
                                                                              "Run forge-doctor for details."}))
        else:
            self.send(404, "{}")

    def send_dash(self, data):
        """Every dashboard answer goes out through here: text from Forge Core and the tools loses its
        control and format characters (bidi overrides and the like) in this one place."""
        self.send(200, json.dumps(forgedash.scrub(data)))

    def dash_get(self, path):
        if not self.authed():
            return self.send(404, "{}")
        if path == "/api/dash/doctor.txt":
            text = DASH.doctor_text()
            if text is None:
                return self.send(500, "The report could not be built. Run forge-doctor in a terminal.", "text/plain")
            data = forgedash.scrub(text).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Disposition",
                             f'attachment; filename="forge-doctor-{time.strftime("%Y%m%d-%H%M%S")}.txt"')
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
            return
        reader = {"/api/dash/home": DASH.home, "/api/dash/metrics": DASH.metrics, "/api/dash/history": DASH.history,
                  "/api/dash/agents": DASH.agents, "/api/dash/timeline": DASH.timeline,
                  "/api/dash/updates": DASH.updates, "/api/dash/backup": DASH.backup,
                  "/api/dash/storage": DASH.storage, "/api/dash/sync": DASH.sync, "/api/dash/hub": DASH.hub,
                  "/api/dash/vms": DASH.vms, "/api/dash/doctor": DASH.doctor_report}.get(path)
        if reader is None:
            return self.send(404, "{}")
        self.send_dash(reader())

    def dash_post(self):
        try:
            length = int(self.headers.get("Content-Length", 0))
        except ValueError:
            return self.send(400, "{}")
        if not 0 <= length <= DASH_BODY_MAX:
            return self.send(413, "{}")
        try:
            body = json.loads(self.rfile.read(length) or b"{}")
        except ValueError:
            return self.send(400, "{}")
        if not isinstance(body, dict):
            return self.send(400, "{}")
        if self.path == "/api/dash/action":
            return self.send_dash(DASH.action(body))
        if self.path == "/api/dash/approvals":
            return self.send_dash(DASH.load_approvals())
        if self.path == "/api/dash/sync-diff":
            return self.send_dash(DASH.sync_diff(body))
        if self.path == "/api/dash/logs":
            return self.send_dash(DASH.logs(body))
        self.send(404, "{}")

    def do_POST(self):
        global last_seen
        if not self.allowed() or not self.authed():
            return self.send(403, "{}")
        last_seen = time.time()
        if DASHBOARD:
            return self.dash_post()
        if self.path == "/api/ui/language":
            return self.language_post()
        if self.path.startswith("/api/appearance"):
            return self.send(404, "{}") if WELCOME else self.look_post()
        if self.path == "/api/open-dashboard":
            # The Settings and Welcome pages' "Open Forge Dashboard" button. Nothing from the request is used.
            try:
                subprocess.Popen(["forge-settings", "--dashboard"], stdin=subprocess.DEVNULL,
                                 stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
            except OSError:
                return self.send(200, json.dumps({"ok": False}))
            return self.send(200, json.dumps({"ok": True}))
        body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")
        if self.path == "/api/save" and body.get("merge") is True:
            # Only the given settings change (the welcome page). Checked here first, then
            # forge-apply checks again against the file as it is when it saves.
            schema = forgecfg.load_schema()
            given = body.get("values")
            keys = {s["key"] for s in schema["settings"]}
            if not isinstance(given, dict) or not given or not set(given) <= keys:
                return self.send(200, json.dumps({"ok": False, "output": "Unknown settings."}))
            _, errors = forgecfg.validate(forgecfg.values(schema, dict(forgecfg.load_overrides(), **given)), schema)
            if errors:
                return self.send(200, json.dumps({"ok": False, "output": "\n".join(errors)}))
            ok, out = save(given, merge=True)
            self.send(200, json.dumps({"ok": ok, "output": out}))
        elif self.path == "/api/save":
            schema = forgecfg.load_schema()
            clean, errors = forgecfg.validate(body.get("values", {}), schema)
            if errors:
                return self.send(200, json.dumps({"ok": False, "output": "\n".join(errors)}))
            switch = body.get("switch_channel")
            if switch is not None and (not isinstance(switch, str) or switch not in forgerelease.CHANNEL_TAGS
                                       or clean.get("updates.channel") != switch):
                return self.send(200, json.dumps({"ok": False, "output": "Not saved: the channel to switch to does not "
                                                                          "match the Update channel setting."}))
            ok, out = save(clean, switch=switch)
            self.send(200, json.dumps({"ok": ok, "output": out}))
        elif self.path == "/api/import-check":
            # Import button: only checks the file. Its settings become unsaved changes on the page,
            # so you see them first, and Save and apply asks for your password as usual.
            text = body.get("text")
            if not isinstance(text, str):
                return self.send(200, json.dumps({"ok": False, "output": "That is not a settings file."}))
            settings, _, notes, err = forgecfg.parse_export(text.encode(), forgecfg.load_schema(), allow_plain=True)
            if err:
                return self.send(200, json.dumps({"ok": False, "output": "Not imported: " + err}))
            self.send(200, json.dumps({"ok": True, "values": settings, "notes": notes}))
        elif self.path == "/api/undo":
            bak = forgecfg.OVERRIDES_PATH + ".bak"
            if not os.path.exists(bak):
                return self.send(200, json.dumps({"ok": False, "output": "Nothing to undo."}))
            with open(bak) as f:
                ok, out = save(forgecfg.values(None, json.load(f)))
            self.send(200, json.dumps({"ok": ok, "output": out}))
        else:
            self.send(404, "{}")

    # Appearance (per user, never root, never forge-apply).

    def look_get(self, path, query):
        if path.startswith("/api/appearance/media/"):
            return self.look_media(path.rsplit("/", 1)[1], query)
        if not self.authed():
            return self.send(404, "{}")
        if path == "/api/appearance":
            schema = forgeappearance.load_schema()
            media = forgeappearance.media_list()
            return self.send(200, json.dumps({
                "schema": schema, "values": forgeappearance.load(schema), "media": media,
                "backends": {s["id"]: forgeappearance.backend_installed(s["id"]) for s in schema["sections"]},
                "caps": {"file": forgeappearance.FILE_CAP, "total": forgeappearance.TOTAL_CAP,
                         "used": sum(m["size"] for m in media)},
                "file": forgeappearance.config_path(), "media_dir": forgeappearance.media_dir(),
                "media_problem": forgeappearance.index_problem()}))
        if path == "/api/appearance/media":
            return self.send(200, json.dumps(forgeappearance.media_list()))
        if path == "/api/appearance/presets":
            schema = forgeappearance.load_schema()
            configured, message = forgepresets.sync_configured()
            return self.send(200, json.dumps({"presets": forgepresets.list_presets(schema),
                                              "sync": {"configured": configured, "message": message,
                                                       "reduced": configured and forgepresets.sync_reduced()}}))
        if path == "/api/appearance/presets/export":
            return self.preset_export(urllib.parse.parse_qs(query).get("id", [""])[0])
        if path == "/api/appearance/choices":
            # Lists for text fields with "choices": "backend" (the section's program, run as you, argv "options").
            sid = urllib.parse.parse_qs(query).get("section", [""])[0]
            try:
                state, fields, text = forgeappearance.section_choices(sid, forgeappearance.load_schema())
            except ValueError:
                return self.send(200, json.dumps({"ok": False, "fields": {}, "output": "Unknown section."}))
            return self.send(200, json.dumps({"ok": state in ("ok", "none"), "fields": fields, "output": text}))
        self.send(404, "{}")

    def look_media(self, mid, query):
        """One media file, only for the owner with the token or the media key. The type comes from the
        file's bytes (checked when it was added), never from its name. SVG is never shown inline: it can
        hold scripts, so it is only offered as a download."""
        key = urllib.parse.parse_qs(query).get("t", [""])[0]
        if not (self.authed() or secrets.compare_digest(key.encode(), MEDIA_KEY.encode())):
            return self.send(404, "{}")
        path = forgeappearance.media_path(mid)
        item = forgeappearance.media_index().get(mid) if path else None
        if item is None:
            return self.send(404, "{}")
        try:
            fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
        except OSError:
            return self.send(404, "{}")
        with os.fdopen(fd, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode):
                return self.send(404, "{}")
            size, start, end = st.st_size, 0, st.st_size - 1
            rng = self.headers.get("Range", "")
            partial = False
            m = re.fullmatch(r"bytes=(\d{0,19})-(\d{0,19})", rng.strip())
            if m and (m.group(1) or m.group(2)) and size:
                if m.group(1):
                    start = int(m.group(1))
                    end = min(int(m.group(2)), size - 1) if m.group(2) else size - 1
                else:
                    start = max(0, size - int(m.group(2)))
                if start > end or start >= size:
                    self.csp = "default-src 'none'; sandbox; frame-ancestors 'none'"
                    self.send_response(416)
                    self.send_header("Content-Range", f"bytes */{size}")
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                partial = True
            self.csp = "default-src 'none'; sandbox; frame-ancestors 'none'"
            self.send_response(206 if partial else 200)
            if item["format"] == "svg":
                self.send_header("Content-Type", "application/octet-stream")
                self.send_header("Content-Disposition", f'attachment; filename="{item["file"]}"')
            else:
                self.send_header("Content-Type", item["mime"])
                self.send_header("Content-Disposition", f'inline; filename="{item["file"]}"')
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Cross-Origin-Resource-Policy", "same-origin")
            self.send_header("Cache-Control", "private, no-store")
            self.send_header("Accept-Ranges", "bytes")
            if partial:
                self.send_header("Content-Range", f"bytes {start}-{end}/{size}")
            self.send_header("Content-Length", str(end - start + 1))
            self.end_headers()
            f.seek(start)
            left = end - start + 1
            try:
                while left > 0:
                    chunk = f.read(min(1024 * 1024, left))
                    if not chunk:
                        break
                    self.wfile.write(chunk)
                    left -= len(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass

    def preview_get(self, path):
        """A preview script from the image, as its own file (the page loads it with the nonce)."""
        m = re.fullmatch(r"/appearance-preview/([a-z][a-z0-9_]{0,31})\.js", path)
        code = preview_code(m.group(1)) if m else None
        if code is None:
            return self.send(404, "{}")
        self.send_response(200)
        self.send_header("Content-Type", "text/javascript; charset=utf-8")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(code)))
        self.end_headers()
        self.wfile.write(code)

    def look_reply(self, code, data):
        self.send(code, json.dumps(data))

    def drain(self, length):
        """Read and drop a refused upload's body (up to 16 MB), so the browser gets the answer instead of a
        reset connection. Bigger bodies are not read: the connection just closes."""
        left = min(length, 16 * 1024 * 1024)
        try:
            while left > 0:
                chunk = self.rfile.read(min(65536, left))
                if not chunk:
                    break
                left -= len(chunk)
        except OSError:
            pass

    def look_upload(self, query):
        global last_seen
        if "Transfer-Encoding" in self.headers:
            return self.look_reply(411, {"ok": False, "output": "Send the file with its size (Content-Length)."})
        raw = self.headers.get("Content-Length")
        if raw is None or raw == "":
            return self.look_reply(411, {"ok": False, "output": "Send the file with its size (Content-Length)."})
        if not re.fullmatch(r"\d{1,19}", raw):
            return self.look_reply(400, {"ok": False, "output": "Bad file size."})
        length = int(raw)
        name = urllib.parse.parse_qs(query).get("name", ["upload"])[0][:1024]
        if length > forgeappearance.FILE_CAP:
            self.drain(length)
            return self.look_reply(413, {"ok": False, "output": "Not added: the file is too large "
                                         f"(at most {forgeappearance.FILE_CAP // 1024 ** 3} GiB)."})

        def alive(_):
            global last_seen
            last_seen = time.time()   # a long upload keeps the page open
        try:
            item = forgeappearance.media_add_stream(self.rfile, length, name, progress=alive)
        except forgeappearance.MediaTooLarge as e:
            self.drain(length)
            return self.look_reply(413, {"ok": False, "output": f"Not added: {e}."})
        except forgeappearance.MediaError as e:
            return self.look_reply(400, {"ok": False, "output": f"Not added: {e}."})
        except OSError as e:
            return self.look_reply(500, {"ok": False, "output": f"Not added: {e.strerror or e}."})
        last_seen = time.time()
        self.look_reply(200, {"ok": True, "item": item})

    def look_post(self):
        path, _, query = self.path.partition("?")
        if path == "/api/appearance/upload":
            return self.look_upload(query)
        if path == "/api/appearance/presets/import":
            return self.preset_import()
        raw = self.headers.get("Content-Length", "0")
        if not re.fullmatch(r"\d{1,19}", raw) or int(raw) > LOOK_BODY_MAX:
            return self.look_reply(413, {"ok": False, "output": "Request too large."})
        try:
            body = json.loads(self.rfile.read(int(raw)) or b"{}")
        except ValueError:
            return self.look_reply(400, {"ok": False, "output": "Not JSON."})
        if not isinstance(body, dict):
            return self.look_reply(400, {"ok": False, "output": "Not JSON."})
        schema = forgeappearance.load_schema()
        if path == "/api/appearance/save":
            try:
                # Checked, merged with what is saved and written as one locked step.
                values, errors = forgeappearance.save_checked(body.get("values"), schema)
            except (OSError, forgeappearance.MediaError) as e:
                return self.look_reply(200, {"ok": False, "output": f"Not saved: {e}"})
            if errors:
                return self.look_reply(200, {"ok": False, "output": "Not saved:\n" + "\n".join(errors[:20])})
            return self.look_reply(200, {"ok": True, "values": values})
        if path == "/api/appearance/apply":
            ids = [s["id"] for s in schema["sections"]]
            sid = body.get("section")
            if sid is not None and sid not in ids:
                return self.look_reply(200, {"ok": False, "output": "Unknown section."})
            results = []
            for one in [sid] if sid else ids:
                state, text = forgeappearance.apply_section(one, schema)
                results.append({"section": one, "state": state, "output": text})
            return self.look_reply(200, {"ok": all(r["state"] != "failed" for r in results), "results": results})
        if path.startswith("/api/appearance/presets/"):
            return self.preset_post(path.rsplit("/", 1)[1], body, schema)
        if path == "/api/appearance/media/remove":
            ok = forgeappearance.media_remove(body.get("id"))
            return self.look_reply(200, {"ok": ok, "values": forgeappearance.load(schema),
                                         "media": forgeappearance.media_list(),
                                         "media_problem": forgeappearance.index_problem()})
        self.send(404, "{}")

    # Appearance presets (per user, see forgepresets). Importing only stores a preset: nothing is run.

    def preset_post(self, action, body, schema):
        pid, fp = body.get("id"), forgepresets
        try:
            if action == "save":
                doc = fp.save_current(body.get("name"), schema)
                return self.look_reply(200, {"ok": True, "preset": fp.summary(doc, forgeappearance.load(schema))})
            if action == "rename":
                doc = fp.rename(pid, body.get("name"))
                return self.look_reply(200, {"ok": True, "preset": fp.summary(doc)})
            if action == "delete":
                return self.look_reply(200, {"ok": fp.delete(pid), "output": None})
            if action == "apply":
                system = body.get("system", False)
                if not isinstance(system, bool):
                    return self.look_reply(200, {"ok": False, "output": "Not applied: bad request."})
                r = fp.apply(pid, include_system=system, schema=schema)
                return self.look_reply(200, r)
            if action == "sync":
                r = fp.sync()
                return self.look_reply(200, dict(r, output=r["message"]))
        except fp.PresetError as e:
            return self.look_reply(200, {"ok": False, "output": f"Not done: {e}."})
        except (OSError, forgeappearance.MediaError) as e:
            return self.look_reply(200, {"ok": False, "output": f"Not done: {getattr(e, 'strerror', None) or e}."})
        self.send(404, "{}")

    def preset_export(self, pid):
        """One preset as a .forgelook file, built in a private temporary file and sent as a download."""
        try:
            name = forgepresets.export_name(pid)
            tmp = forgepresets.scratch_file()
        except forgepresets.PresetError:
            return self.send(404, "{}")
        except OSError:
            return self.send(500, "{}")
        with tmp:
            try:
                forgepresets.export(pid, tmp)
            except (forgepresets.PresetError, OSError):
                return self.send(500, "{}")
            size = tmp.tell()
            tmp.seek(0)
            plain = name if name.isascii() else "forge-preset" + forgepresets.SUFFIX
            self.csp = "default-src 'none'; sandbox; frame-ancestors 'none'"
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Disposition", f'attachment; filename="{plain}"; '
                             f"filename*=UTF-8''{urllib.parse.quote(name)}")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(size))
            self.end_headers()
            try:
                while True:
                    chunk = tmp.read(1024 * 1024)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass

    def preset_import(self):
        global last_seen
        raw = self.headers.get("Content-Length")
        if "Transfer-Encoding" in self.headers or not raw:
            return self.look_reply(411, {"ok": False, "output": "Send the file with its size (Content-Length)."})
        if not re.fullmatch(r"\d{1,19}", raw):
            return self.look_reply(400, {"ok": False, "output": "Bad file size."})
        length = int(raw)
        if length > forgepresets.IMPORT_MAX:
            if length <= 64 * 1024 * 1024:
                self.drain(length)
            self.close_connection = True
            return self.look_reply(413, {"ok": False, "output": "Not imported: the file is too large."})
        try:
            tmp = forgepresets.scratch_file()
        except OSError as e:
            return self.look_reply(500, {"ok": False, "output": f"Not imported: {e.strerror or e}."})
        with tmp:
            left = length
            try:
                while left > 0:
                    chunk = self.rfile.read(min(1024 * 1024, left))
                    if not chunk:
                        return self.look_reply(400, {"ok": False, "output": "Not imported: the file arrived incomplete."})
                    tmp.write(chunk)
                    left -= len(chunk)
                    last_seen = time.time()
                tmp.seek(0)
                doc = forgepresets.import_file(tmp)
            except forgepresets.PresetError as e:
                return self.look_reply(200, {"ok": False, "output": f"Not imported: {e}."})
            except OSError as e:
                return self.look_reply(500, {"ok": False, "output": f"Not imported: {e.strerror or e}."})
        last_seen = time.time()
        self.look_reply(200, {"ok": True, "preset": forgepresets.summary(doc)})

    def language_post(self):
        raw = self.headers.get("Content-Length", "0")
        if not re.fullmatch(r"\d{1,5}", raw) or int(raw) > 4096:
            return self.send(413, "{}")
        try:
            body = json.loads(self.rfile.read(int(raw)) or b"{}")
            choice = body.get("language") if isinstance(body, dict) else None
            forgei18n.set_preference(choice)
        except ValueError:
            return self.send(200, json.dumps({"ok": False, "output": "Unknown language."}))
        except OSError as e:
            return self.send(200, json.dumps({"ok": False, "output": f"Not saved: {e.strerror or e}."}))
        self.send(200, json.dumps({"ok": True, "i18n": forgei18n.page_data(forgei18n.language())}))


IDLE_S = float(os.environ.get("FORGE_IDLE_S", "120"))   # close after this long without our browser


class Server(ThreadingHTTPServer):
    daemon_threads = True
    max_threads = 16
    # Room for waiting connections, so a flood from another user can't easily crowd out yours.
    request_queue_size = 128

    def verify_request(self, request, client_address):
        # Checked as soon as a connection arrives, before it gets a thread: another user's
        # connections are closed at once and can't pile up.
        return owner_connection(client_address, self.server_address)

    def process_request(self, request, client_address):
        if threading.active_count() > self.max_threads:
            self.shutdown_request(request)
            return
        super().process_request(request, client_address)

    def handle_error(self, request, client_address):
        pass   # a dropped or timed-out connection is normal here; don't fill the log with tracebacks


def doctor_report():
    """The compatibility report (read-only, no root). One at a time, reused for 30 seconds."""
    with doctor_lock:
        at = doctor_last["at"]
        if at is None or not (0 <= time.monotonic() - at < 30):
            try:
                from forgecore import doctor
                doctor_last.update(report=doctor.build_report(), at=time.monotonic())
            except Exception:
                return None
        return doctor_last["report"]


def dashboard_page():
    path = os.path.join(os.path.dirname(os.path.abspath(forgedash.__file__)), "dashboard.html")
    with open(path, encoding="utf-8") as f:
        page = f.read()
    page = page.replace("__TOKEN__", TOKEN).replace("__NONCE__", NONCE)
    return page.replace("<!--__I18N__-->", i18n_block(), 1)


def i18n_block():
    """The text tables and the small translation runtime for a page (forgei18n)."""
    try:
        return forgei18n.page_block(forgei18n.language(), NONCE)
    except Exception:
        return forgei18n.page_block("en", NONCE)


def preview_code(sid):
    """Bytes of PREVIEW_DIR/<sid>.js for a section in the schema, or None (missing, a link, too big)."""
    try:
        ids = [s["id"] for s in forgeappearance.load_schema()["sections"]]
    except Exception:
        return None
    if sid not in ids:
        return None
    try:
        fd = os.open(os.path.join(PREVIEW_DIR, sid + ".js"), os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_size > PREVIEW_MAX:
            return None
        return f.read(PREVIEW_MAX)


def preview_scripts(schema):
    """One <script nonce src> per preview file. Loaded as separate files, so nothing in them can change the
    page's own markup."""
    return "\n".join(f'<script nonce="{NONCE}" src="/appearance-preview/{s["id"]}.js"></script>'
                      for s in schema["sections"] if preview_code(s["id"]) is not None)


def settings_page():
    try:
        schema = forgeappearance.load_schema()
    except Exception:
        schema = {"sections": []}
    page = PAGE.replace("__TOKEN__", TOKEN).replace("__MEDIA_KEY__", MEDIA_KEY).replace("__NONCE__", NONCE)
    page = page.replace("<!--__I18N__-->", i18n_block(), 1)
    return page.replace("<!--__PREVIEW_HOOKS__-->", preview_scripts(schema), 1)


def welcome_marker():
    base = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.path.join(base, "forge", "welcome-shown") if os.path.isabs(base) else None


def first_welcome():
    """True if this user has not seen the welcome page yet."""
    marker = welcome_marker()
    return marker is not None and not os.path.lexists(marker)


def mark_welcome_shown():
    """Recorded only once the page is actually served, so a browser that failed to open
    at login doesn't use it up."""
    marker = welcome_marker()
    try:
        os.makedirs(os.path.dirname(marker), mode=0o700, exist_ok=True)
        os.close(os.open(marker, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600))
    except (OSError, TypeError):
        pass


def launch_dir():
    """A 0700 folder of yours in $XDG_RUNTIME_DIR (or ~/.cache) for the private launch page."""
    base = os.environ.get("XDG_RUNTIME_DIR", "")
    if not os.path.isabs(base):
        base = os.path.join(os.path.expanduser("~"), ".cache")
    d = os.path.join(base, "forge-settings")
    os.makedirs(base, mode=0o700, exist_ok=True)
    try:
        os.mkdir(d, 0o700)
    except FileExistsError:
        pass
    st = os.lstat(d)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise OSError(errno.EPERM, f"{d} is not a private folder of yours")
    os.chmod(d, 0o700)
    now = time.time()
    for name in os.listdir(d):   # left by a run that was killed before it could clean up
        p = os.path.join(d, name)
        try:
            if name.endswith(".html") and now - os.lstat(p).st_mtime > 600:
                os.unlink(p)
        except OSError:
            pass
    return d


def launch_page(url):
    """Write a 0600 page that sends the browser on to url (with the launch key), and return its path."""
    path = os.path.join(launch_dir(), f"open-{secrets.token_hex(8)}.html")
    u = html.escape(url, quote=True)
    body = ('<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="referrer" content="no-referrer">'
            f'<meta http-equiv="refresh" content="0;url={u}"><title>Forge</title></head>'
            f'<body><script>location.replace({json.dumps(url)});</script>'
            f'<p><a href="{u}">Open</a></p></body></html>\n')
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        os.fchmod(f.fileno(), 0o600)
        f.write(body)
    return path


def forget_launch_page():
    global LAUNCH_PAGE
    page, LAUNCH_PAGE = LAUNCH_PAGE, None
    if page:
        try:
            os.unlink(page)
        except OSError:
            pass


def watchdog(server):
    while True:
        time.sleep(min(15.0, IDLE_S / 4))
        if time.time() - last_seen > IDLE_S:
            server.shutdown()
            return


def main():
    global WELCOME, WELCOME_ONCE, DASHBOARD, DASH, LAUNCH_PAGE
    args = sys.argv[1:]
    if args not in ([], ["--welcome"], ["--welcome-once"], ["--dashboard"]):
        print("Usage: forge-settings [--welcome | --welcome-once | --dashboard]", file=sys.stderr)
        sys.exit(2)
    if os.geteuid() == 0:
        sys.exit("forge-settings: don't run this as root. Run it as your normal user; "
                 "saving asks for your password.")
    # The welcome page is for people, not system accounts such as Plasma Setup's temporary user,
    # whose session runs the first-boot wizard (it would open on top of it).
    if args == ["--welcome-once"] and (os.getuid() < 1000 or not first_welcome()):
        return
    DASHBOARD = args == ["--dashboard"]
    if DASHBOARD:
        DASH = forgedash.Dashboard()
    WELCOME = bool(args) and not DASHBOARD
    WELCOME_ONCE = args == ["--welcome-once"]
    if not WELCOME and not DASHBOARD:
        try:
            forgeappearance.media_cleanup()   # what a killed upload left behind
        except (OSError, forgeappearance.MediaError):
            pass
    server = Server(("127.0.0.1", int(os.environ.get("FORGE_PORT", "0"))), Handler)
    url = f"http://127.0.0.1:{server.server_address[1]}/?k={LAUNCH_KEY}"
    threading.Thread(target=watchdog, args=(server,), daemon=True).start()
    if os.environ.get("FORGE_NO_BROWSER"):
        print(f"Forge Settings: {url}")   # you asked to open it yourself, so you need the full link
    else:
        # The one-time key is not printed (output from menu launches can end up in the system log),
        # and not put on xdg-open's command line: the browser opens a private page that holds it.
        name = "Forge Dashboard" if DASHBOARD else "Forge Settings"
        try:
            LAUNCH_PAGE = launch_page(url)
        except OSError as e:
            server.server_close()
            sys.exit(f"{name}: could not make a private page to open your browser with ({e.strerror or e}). "
                     "Set FORGE_NO_BROWSER=1 and run it again to get the link instead.")
        print(f"{name} is opening in your browser (http://127.0.0.1:{server.server_address[1]}).")
        subprocess.Popen(["xdg-open", LAUNCH_PAGE], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        server.serve_forever()
    finally:
        forget_launch_page()


