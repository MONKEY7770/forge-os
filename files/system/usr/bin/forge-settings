const $ = s => document.querySelector(s);
const el = (tag, attrs = {}, kids = []) => {
  const e = document.createElement(tag);
  for (const [k, v] of Object.entries(attrs)) {
    if (v === null || v === undefined || v === false) continue;
    if (k === "text") e.textContent = v; else e.setAttribute(k, v === true ? "" : v);
  }
  kids.forEach(k => k && e.append(k)); return e;
};
const same = (a, b) => JSON.stringify(a) === JSON.stringify(b);
const fmt = v => v === true ? t("ui.on") : v === false ? t("ui.off") : String(v);
const still = () => matchMedia("(prefers-reduced-motion: reduce)").matches;
// Lucide icons (ISC license), built as SVG nodes: never from markup text.
const ICONS = {x: ["M18 6 6 18", "m6 6 12 12"], chevron: ["m6 9 6 6 6-6"],
               undo: ["M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8", "M3 3v5h5"],
               image: ["M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z", "M9 7a2 2 0 1 1 0 4 2 2 0 0 1 0-4z",
                       "m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"]};
function icon(name) {
  const NS = $("#more svg").namespaceURI, svg = document.createElementNS(NS, "svg");   // the SVG namespace, from the page's own icon
  svg.setAttribute("viewBox", "0 0 24 24"); svg.setAttribute("class", "ic"); svg.setAttribute("aria-hidden", "true");
  ICONS[name].forEach(d => { const path = document.createElementNS(NS, "path"); path.setAttribute("d", d); svg.append(path); });
  return svg;
}
// One line for screen readers (the page itself is not a live region).
function announce(text) { const l = $("#live"); l.textContent = ""; setTimeout(() => { l.textContent = text; }, 30); }

// Messages as toasts at the bottom right. Success goes away after 4 seconds, errors stay until closed.
function toast(ok, title, detail) {
  if (detail === undefined) { const i = String(title).indexOf("\n"); if (i >= 0) { detail = title.slice(i + 1); title = title.slice(0, i); } }
  const x = el("button", {type: "button", class: "x", "aria-label": t("ui.close"), title: t("ui.close")}, [icon("x")]);
  const box = el("div", {class: "toast " + (ok ? "ok" : "bad")}, [
    el("div", {class: "tx"}, [el("div", {class: "tt", text: title}), detail ? el("pre", {text: detail}) : null]), x]);
  const gone = () => {
    if (!box.isConnected || box.classList.contains("going")) return;
    box.classList.add("going");
    setTimeout(() => box.remove(), still() ? 0 : 130);
  };
  x.addEventListener("click", gone);
  const all = $("#toasts");
  while (all.children.length >= 3) all.firstChild.remove();
  all.append(box);
  if (ok) setTimeout(gone, 4000);
  return box;
}

// A question in a page dialog, in your language (never the browser's own boxes). Resolves to true, the typed text,
// or false when cancelled (Cancel, Esc or a click outside).
let askDone = null, askInput = false;
function ask({title, body, ok, danger, input}) {
  if (askDone) askDone(false);
  return new Promise(resolve => {
    $("#ask-title").textContent = title;
    $("#ask-body").replaceChildren(...[].concat(body || []).filter(Boolean).map(p => el("p", {text: p})));
    const okb = $("#ask-ok"), inp = $("#ask-input");
    okb.textContent = ok;
    okb.className = "btn primary" + (danger ? " danger" : "");
    askInput = !!input;
    $("#ask-field").hidden = !input;
    if (input) { $("#ask-label").textContent = input.label; inp.value = input.value || ""; inp.maxLength = input.max || 60; }
    okb.disabled = askInput && !inp.value.trim();
    askDone = v => { askDone = null; resolve(v); };
    $("#ask").showModal();
    (input ? inp : danger ? $("#ask-cancel") : okb).focus();
  });
}
function askAnswer(v) { const d = askDone; askDone = null; if ($("#ask").open) $("#ask").close(); if (d) d(v); }
$("#ask-ok").addEventListener("click", () => askAnswer(askInput ? $("#ask-input").value : true));
$("#ask-cancel").addEventListener("click", () => askAnswer(false));
$("#ask").addEventListener("close", () => { if (askDone) askAnswer(false); });
$("#ask-input").addEventListener("input", () => { $("#ask-ok").disabled = !$("#ask-input").value.trim(); });
$("#ask-input").addEventListener("keydown", e => { if (e.key === "Enter" && !$("#ask-ok").disabled) { e.preventDefault(); $("#ask-ok").click(); } });
// Every dialog closes on Esc (the browser does that) and on a click on the dimmed page around it.
document.querySelectorAll("dialog").forEach(d => d.addEventListener("click", e => { if (e.target === d) d.close(); }));

// The six sidebar sections and which settings groups (by id) each holds.
// A group not listed here shows under System, so nothing ever disappears. Labels: ui.nav.<id>, ui.sec.<id>.help.
const SECTIONS = [
  {id: "appearance", groups: []},
  {id: "system", groups: ["modes", "gaming", "apps", "virt", "storage", "updates"]},
  {id: "network", groups: ["network", "devices"]},
  {id: "privacy", groups: ["privacy", "security"]},
  {id: "ai", groups: ["ai", "agents", "core", "monitor"]},
  {id: "data", groups: ["sync", "backup"]},
];
const secLabel = S => t("ui.nav." + S.id);
