// Labels and help from the two schemas, in your language when the table has them.
const setLabel = s => tl("set." + s.key + ".label", s.label);
const setHelp = s => s.help ? tl("set." + s.key + ".help", s.help) : "";
const groupLabel = g => tl("set.group." + g.id, g.label);
