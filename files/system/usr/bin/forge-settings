<!--__I18N__-->
<script nonce="__NONCE__">
const TOKEN = "__TOKEN__";
const H = {"X-Forge-Token": TOKEN, "Content-Type": "application/json"};
const $ = q => document.querySelector(q);
function el(tag, text, cls) { const e = document.createElement(tag); if (text) e.textContent = text; if (cls) e.className = cls; return e; }
applyStatic();
const MARK = {ok: ["dash.mark.ok", "ok"], warn: ["dash.mark.warn", "warn"], info: ["dash.mark.info", "info"], unknown: ["dash.mark.unknown", ""]};

// The report comes from forge-doctor in English. Section names have their own entries in the tables;
// lines are translated where the tables know them (tr) and otherwise shown as they are.
const secName = name => tl("welcome.rep." + String(name).toLowerCase().replace(/[^a-z0-9]+/g, "_"), tr(name));
async function report() {
  const box = $("#report");
  try {
    const r = await fetch("/api/doctor", {headers: H});
    const d = await r.json();
    if (!r.ok) throw new Error(d.error || "failed");
    const s = d.summary || {};
    const rows = el("div", "", "rows");
    for (const sec of d.sections) {
      // Lines with nothing to say (empty, or a name with no value after it) are left out.
      const items = (sec.items || []).map(i => String(i).trim()).filter(i => i && !/:$/.test(i));
      const left = el("div");
      left.append(el("div", secName(sec.name), "t"));
      if (items.length) { const ul = el("ul", "", "d"); items.forEach(i => ul.append(el("li", tr(i)))); left.append(ul); }
      const m = MARK[sec.status] || [null, ""];
      const row = el("div", "", "row");
      row.append(left, el("span", m[0] ? t(m[0]) : String(sec.status), "pill " + m[1]));
      rows.append(row);
    }
    box.replaceChildren(el("p", t("dash.diag.head", {ok: s.ok || 0, warn: s.warn || 0, unknown: s.unknown || 0}), "summary"), rows);
  } catch (e) {
    box.replaceChildren(el("p", t("welcome.report_failed"), "muted"));
  }
  box.setAttribute("aria-busy", "false");
}

// Save is offered only once something differs from what is saved, and says "Saved" only after forge-apply answered.
let values = null;
const switches = () => [...document.querySelectorAll("[data-key]")];
const changed = () => values !== null && switches().some(c => c.checked !== !!values[c.dataset.key]);
const sync = () => { if (!$("#save").classList.contains("busy")) $("#save").disabled = !changed(); };
async function load() {
  try {
    const r = await fetch("/api/settings", {headers: H});
    values = (await r.json()).values;
  } catch (e) { return; }
  switches().forEach(c => { c.checked = !!values[c.dataset.key]; c.addEventListener("change", sync); });
  sync();
}

function result(ok, title, detail) {
  const out = $("#out");
  out.className = "result " + (ok ? "ok" : "bad");
  out.replaceChildren(document.createTextNode(title));
  if (detail) out.append(el("pre", detail));
}
$("#save").onclick = async () => {
  // Only these settings are sent, as a merge, so a change made elsewhere meanwhile is kept.
  const next = {};
  switches().forEach(c => { next[c.dataset.key] = c.checked; });
  const b = $("#save");
  b.disabled = true; b.classList.add("busy"); b.setAttribute("aria-busy", "true"); b.textContent = t("ui.saving");
  try {
    const r = await fetch("/api/save", {method: "POST", headers: H, body: JSON.stringify({values: next, merge: true})});
    const d = await r.json();
    if (d.ok) values = Object.assign({}, values, next);
    result(d.ok, d.ok ? t("ui.saved") : t("ui.not_saved"), d.output ? tr(d.output) : "");
  } catch (e) {
    result(false, t("welcome.closed"));
  }
  b.classList.remove("busy"); b.removeAttribute("aria-busy"); b.textContent = t("ui.save");
  sync();
};

document.querySelectorAll("[data-copy]").forEach(b => {
  let timer = 0;
  b.onclick = async () => {
    try { await navigator.clipboard.writeText(b.dataset.copy); b.textContent = t("welcome.copied"); }
    catch (e) { b.textContent = t("welcome.select_copy"); }
    clearTimeout(timer);
    timer = setTimeout(() => { b.textContent = t("welcome.copy"); }, 2000);
  };
});

let dashTimer = 0;
$("#dash").onclick = async () => {
  const r = await fetch("/api/open-dashboard", {method: "POST", headers: H, body: "{}"}).catch(() => null);
  $("#dash").textContent = r && r.ok && (await r.json()).ok ? t("ui.dash.opening") : t("ui.dash.failed");
  clearTimeout(dashTimer);
  dashTimer = setTimeout(() => { $("#dash").textContent = t("ui.dash.open"); }, 3000);
};

// Done: closes the tab where the browser allows a page to do that, and otherwise says it can be closed.
$("#done").onclick = () => {
  $("#done-note").textContent = t("welcome.done.note");
  window.close();
};

setInterval(() => fetch("/api/ping", {headers: H}).catch(() => null), 30000);
report(); load();
</script>
</body>
</html>
"""

if __name__ == "__main__":
    main()
