// Search: every word must match the label, help, key or tags (or the name of the card it is in), in English
// or in your language. "#word" matches one tag exactly.
function matches(item, q, where, shown) {
  if (!q) return true;
  const tags = item.tags || [];
  const hay = (item.label + " " + (item.help || "") + " " + item.key + " " + tags.join(" ") + " " + (where || "") + " "
               + (shown || "")).toLowerCase();
  return q.split(/\s+/).every(w => w.startsWith("#") ? tags.includes(w.slice(1)) : hay.includes(w));
}
const query = () => $("#search").value.trim().toLowerCase();

function groupsIn(sid) {
  const known = SECTIONS.find(s => s.id === sid).groups;
  const order = known.map(id => schema.groups.find(g => g.id === id)).filter(Boolean);
  if (sid === "system") schema.groups.forEach(g => { if (!SECTIONS.some(s => s.groups.includes(g.id))) order.push(g); });
  return order;
}

// Controls for the system settings (forge-apply, asks for your password)

const hasRange = s => typeof s.min === "number" && typeof s.max === "number";
const rangeText = s => (hasRange(s) ? t("ui.range", {min: s.min, max: s.max}) : "") + (s.unit ? " " + s.unit : "");

// A number field never stores an empty or unreadable value: it says what it needs, and on leaving the field
// an empty one goes back to the last good value and one out of range is brought into range.
function numberControl(s, compact) {
  const id = "err-" + s.key.replace(/[^a-z0-9_-]/gi, "-");
  const input = el("input", {type: "number", "aria-label": setLabel(s), min: s.min, max: s.max, spellcheck: "false",
                             "aria-describedby": id});
  input.value = current[s.key];
  const err = el("div", {class: "err", id, hidden: true});
  const read = () => {
    const raw = input.value.trim(), n = Number(raw);
    return raw === "" || input.validity.badInput || !Number.isFinite(n) ? null : n;
  };
  const inRange = n => !hasRange(s) || n >= s.min && n <= s.max;
  const mark = bad => {
    input.setAttribute("aria-invalid", String(bad));
    err.hidden = !bad;
    err.textContent = bad ? (hasRange(s) ? t("ui.num.range", {min: s.min, max: s.max}) : t("ui.num.needed")) : "";
  };
  input.addEventListener("input", () => {
    const n = read();
    mark(n === null || !inRange(n));
    if (n !== null && inRange(n)) set(s.key, n);
  });
  input.addEventListener("blur", () => {
    let n = read();
    if (n === null) n = current[s.key];
    else if (!inRange(n)) n = Math.min(s.max, Math.max(s.min, n));
    input.value = n;
    mark(false);
    if (!same(n, current[s.key])) set(s.key, n);
  });
  const kids = [input];
  if (!compact && hasRange(s)) kids.push(el("span", {class: "range", text: rangeText(s)}));
  kids.push(err);
  return el("span", {class: "num"}, kids);
}

function control(s, compact) {
  const v = current[s.key];
  if (s.type === "toggle") {
    const input = el("input", {type: "checkbox", role: "switch", "aria-label": setLabel(s)});
    input.checked = v;
    input.addEventListener("change", () => set(s.key, input.checked));
    return el("label", {class: "switch"}, [input, el("span", {class: "knob"})]);
  }
  if (s.type === "select") {
    const input = el("select", {"aria-label": setLabel(s)});
    s.options.forEach(o => { const op = el("option", {value: o, text: optLabel(o)}); if (o === v) op.selected = true; input.append(op); });
    input.addEventListener("change", () => set(s.key, input.value));
    return input;
  }
  if (s.type === "number") return numberControl(s, compact);
  const input = el("input", {type: "text", "aria-label": setLabel(s), spellcheck: "false"});
  input.value = v;
  input.addEventListener("input", () => set(s.key, input.value));
  return input;
}

function tagButtons(tags) {
  return el("div", {class: "rtags"}, (tags || []).map(tag => {
    const b = el("button", {type: "button", text: "#" + tag, title: t("ui.tag.title", {tag})});
    b.addEventListener("click", () => { $("#search").value = "#" + tag; clearTimeout(searchTimer); render(); });
    return b;
  }));
}

const resetTitle = s => t("ui.reset.title", {value: s.type === "select" ? optLabel(s.default) : fmt(s.default)});

function settingRow(s, q) {
  const changed = !same(current[s.key], saved[s.key]);
  const custom = !same(current[s.key], s.default);
  const reset = el("button", {type: "button", class: "reset", title: resetTitle(s), text: t("ui.reset")});
  reset.addEventListener("click", () => set(s.key, s.default, true));
  const label = el("div", {class: "label"}, [el("span", {class: "dot", title: t("ui.unsaved_dot")}), el("span", {text: setLabel(s)})]);
  if (s.advanced) label.append(el("span", {class: "pill", text: t("ui.advanced")}));
  const info = el("div", {}, [label]);
  if (s.help) info.append(el("div", {class: "help", text: setHelp(s)}));
  if (q) info.append(tagButtons(s.tags));      // tags only help in search results
  return el("div", {class: "row" + (changed ? " changed" : "") + (custom ? " custom" : ""), "data-key": s.key},
            [info, el("div", {class: "ctl"}, [reset, control(s)])]);
}

// The folded part of a card: opens and closes in place (no new render), by its rows' height.
function foldAway(id, rows, n) {
  const open = openAdv.has(id);
  const wrap = el("div", {class: "adv" + (open ? " open" : ""), id: "adv-" + id, inert: !open}, [el("div", {class: "adv-in"}, rows)]);
  const label = el("span", {text: open ? t("ui.adv.hide") : tn("ui.adv.show", n)});
  const b = el("button", {type: "button", class: "more", "aria-expanded": String(open), "aria-controls": wrap.id}, [icon("chevron"), label]);
  b.addEventListener("click", () => {
    const now = !openAdv.has(id);
    now ? openAdv.add(id) : openAdv.delete(id);
    wrap.classList.toggle("open", now);
    wrap.inert = !now;
    b.setAttribute("aria-expanded", String(now));
    label.textContent = now ? t("ui.adv.hide") : tn("ui.adv.show", n);
  });
  return [wrap, b];
}

// Advanced settings stay folded away unless you open them, search for them, or changed them.
function groupCard(g, items, q) {
  if (g.id === "modes" && !q) return modesCard(g, items);
  const card = el("section", {class: "card", id: "g-" + g.id, "aria-labelledby": "h-" + g.id},
                  [el("h3", {id: "h-" + g.id, text: groupLabel(g)})]);
  const shownAlways = s => !s.advanced || q || !same(current[s.key], s.default) || !same(current[s.key], saved[s.key]);
  const folded = items.filter(s => !shownAlways(s));
  items.forEach(s => { if (shownAlways(s)) card.append(settingRow(s, q)); });
  if (folded.length) card.append(...foldAway(g.id, folded.map(s => settingRow(s, q)), folded.length));
  return card;
}

// Performance modes: the same few settings for each mode, as one grid (a column per mode, a row per setting).
// Each cell is the usual control for its own setting, so saving works exactly as for any other row.
const MODE_KEY = /^modes\.([a-z0-9_]+)\.([a-z0-9_]+)$/;
function modesCard(g, items) {
  const card = el("section", {class: "card", id: "g-" + g.id, "aria-labelledby": "h-" + g.id},
                  [el("h3", {id: "h-" + g.id, text: groupLabel(g)})]);
  const modes = [], parts = [], cells = {};
  items.forEach(s => {
    const m = MODE_KEY.exec(s.key);
    if (!m) return;
    if (!modes.includes(m[1])) modes.push(m[1]);
    if (!parts.includes(m[2])) parts.push(m[2]);
    cells[m[1] + "/" + m[2]] = s;
  });
  if (modes.length) {
    const head = el("tr", {}, [el("th", {scope: "col"}, [el("span", {class: "sr", text: t("ui.modes.setting")})]),
                               ...modes.map(m => el("th", {scope: "col", text: optLabel(m)}))]);
    const body = parts.map(part => {
      const first = cells[modes[0] + "/" + part];
      let name = first ? setLabel(first).replace(/^[^:]+:\s*/, "") : part;
      name = name.charAt(0).toUpperCase() + name.slice(1);    // sentence case once the mode name is gone
      const th = el("th", {scope: "row"}, [document.createTextNode(name)]);
      if (first && first.type === "number" && hasRange(first)) th.append(el("span", {class: "range", text: rangeText(first)}));
      return el("tr", {}, [th, ...modes.map(m => {
        const s = cells[m + "/" + part];
        if (!s) return el("td");
        const reset = el("button", {type: "button", class: "reset", title: resetTitle(s), "aria-label": t("ui.reset") + ": " + setLabel(s)}, [icon("undo")]);
        reset.addEventListener("click", () => set(s.key, s.default, true));
        return el("td", {class: "cell" + (!same(current[s.key], saved[s.key]) ? " changed" : "") + (!same(current[s.key], s.default) ? " custom" : ""),
                         "data-key": s.key}, [el("span", {class: "in"}, [el("span", {class: "dot", title: t("ui.unsaved_dot")}), control(s, true), reset])]);
      })]);
    });
    card.append(el("div", {class: "grid-wrap"}, [el("table", {class: "modes-grid"}, [el("thead", {}, [head]), el("tbody", {}, body)])]));
  }
  items.filter(s => !MODE_KEY.test(s.key)).forEach(s => card.append(settingRow(s, "")));
  return card;
}

// Appearance (per user, saved right away to your home folder, no password)

const PREVIEW_HOOKS = {};
// Later parts of Forge OS add /usr/share/forge/appearance-preview/<section>.js, which calls this.
window.forgeAppearance = Object.freeze({
  registerPreview(section, fn) { if (typeof fn === "function") (PREVIEW_HOOKS[section] = PREVIEW_HOOKS[section] || []).push(fn); },
});
const mediaUrl = id => "/api/appearance/media/" + encodeURIComponent(id) + "?t=" + encodeURIComponent(MEDIA_KEY);
const mediaItem = id => A.media.find(m => m.id === id);
const KIND = {"image": "ui.kind.image", "animated-image": "ui.kind.animated", "video": "ui.kind.video"};
const kindLabel = k => t(KIND[k] || "ui.kind.image");
const ACCEPT = {image: ["image", "animated-image"], video: ["video"], any: ["image", "animated-image", "video"]};
const PICK = {
  image: "image/*,.heic,.heif,.avif,.jxl,.apng,.ico,.tif,.tiff,.bmp,.svg",
  video: "video/*,.mkv,.webm,.mov,.avi,.wmv,.flv,.mpg,.mpeg,.ogv,.3gp,.ts,.m4v",
};
PICK.any = PICK.image + "," + PICK.video;
// show_if; a field is also hidden when the field it depends on is hidden.
const looksVisible = (f, vals) => {
  const sec = A.schema.sections.find(s => s.fields.includes(f));
  const seen = new Set();
  while (f && !seen.has(f.key)) {
    seen.add(f.key);
    const c = f.show_if; if (!c) return true;
    const ok = x => same(vals[c.key], x);
    if (!("equals" in c ? ok(c.equals) : c.in.some(ok))) return false;
    f = sec ? sec.fields.find(x => x.key === c.key) : null;
  }
  return true;
};
const lookDirty = sid => !same(A.current[sid], A.saved[sid]);

function size(n) {
  const u = [t("ui.unit.bytes"), "KB", "MB", "GB"]; let i = 0;
  while (n >= 1024 && i < 3) { n /= 1024; i++; }
  return (i ? n.toFixed(n < 10 ? 1 : 0) : n) + " " + u[i];
}

function thumb(item, label) {
  const box = el("div", {class: "thumb"});
  if (!item) {
    if (label) box.textContent = label; else { box.classList.add("none"); box.append(icon("image")); }
    return box;
  }
  const fallback = () => { box.replaceChildren(document.createTextNode(t("ui.file_of", {format: item.format.toUpperCase()}))); };
  if (item.format === "svg") {
    box.textContent = t("ui.svg_no_preview");   // SVG can carry scripts, so it is never shown here
  } else if (item.kind === "video") {
    const v = el("video", {muted: true, preload: "metadata", playsinline: true, "aria-hidden": "true"});
    v.muted = true; v.src = mediaUrl(item.id) + "#t=0.5";
    v.addEventListener("error", fallback);
    box.append(v);
  } else {
    const i = el("img", {alt: "", loading: "lazy", decoding: "async"});
    i.addEventListener("error", fallback);
    i.src = mediaUrl(item.id);
    box.append(i);
  }
  box.append(el("span", {class: "k", text: kindLabel(item.kind)}));
  return box;
}

// One preview per section, kept from render to render: a playing video wallpaper is not started again
// and the preview scripts keep their state.
const PREVIEW_NODES = new Map();
function previewEl(sid) {
  const sec = A.schema.sections.find(s => s.id === sid);
  const label = t("ui.preview_of", {name: sec ? lookSecLabel(sec) : sid});
  const kept = PREVIEW_NODES.get(sid);
  if (kept) { kept.setAttribute("aria-label", label); return kept; }
  const node = el("div", {class: "fa-preview", "data-section": sid, role: "img", "aria-label": label}, [
    el("div", {class: "fa-wall"}),
    el("div", {class: "fa-window"}, [el("i"), el("i"), el("i")]),
    el("div", {class: "fa-dock"}, [el("i"), el("i"), el("i"), el("i"), el("i"), el("i")]),
    el("div", {class: "fa-boot"}, [el("b", {}, [document.createTextNode("Forge "), el("span", {text: "OS"})]),
                                   el("div", {class: "fa-progress"}, [el("i")])]),
  ]);
  PREVIEW_NODES.set(sid, node);
  return node;
}

// The wallpaper in every preview comes from the Background section: its first shown media field
// with a file, otherwise its first shown color field.
function paintWall(wall) {
  const bg = A.schema.sections.find(s => s.id === "background");
  const vals = A.current.background || {};
  let media = null, color = null;
  (bg ? bg.fields : []).forEach(f => {
    if (!looksVisible(f, vals)) return;
    if (f.type === "media" && !media && vals[f.key] && mediaItem(vals[f.key])) media = mediaItem(vals[f.key]);
    if (f.type === "color" && !color) color = vals[f.key];
  });
  const want = media && media.format !== "svg" ? media.id : "";
  if (wall.dataset.media !== want) {
    wall.dataset.media = want;
    wall.replaceChildren();
    if (want && media.kind === "video") {
      const v = el("video", {muted: true, loop: true, playsinline: true, preload: "metadata", "aria-hidden": "true"});
      v.muted = true;
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) v.autoplay = true;
      v.src = mediaUrl(want);
      wall.append(v);
    } else if (want) {
      wall.append(el("img", {alt: "", src: mediaUrl(want)}));
    }
  }
  wall.style.background = !want && color ? color : "";
}

function updatePreviews() {
  document.querySelectorAll(".fa-preview").forEach(p => {
    const sid = p.dataset.section, sec = A.schema.sections.find(s => s.id === sid);
    if (!sec) return;
    paintWall(p.querySelector(".fa-wall"));
    const vals = A.current[sid] || {};
    sec.fields.forEach(f => {
      const v = vals[f.key];
      p.setAttribute("data-" + f.key.replace(/_/g, "-"), String(v));
      const css = typeof v === "number" ? v + (["px", "%", "ms", "s", "deg"].includes(f.unit) ? f.unit : "")
                : typeof v === "boolean" ? (v ? "1" : "0") : f.type === "color" ? v : JSON.stringify(String(v));
      p.style.setProperty("--fa-" + f.key.replace(/_/g, "-"), css);
    });
    const media = {};
    A.media.forEach(m => { media[m.id] = Object.assign({}, m, {url: m.format === "svg" ? null : mediaUrl(m.id)}); });
    const ctx = {section: sid, values: Object.assign({}, vals), all: JSON.parse(JSON.stringify(A.current)), media,
                 fields: sec.fields, wall: p.querySelector(".fa-wall"), window: p.querySelector(".fa-window"),
                 dock: p.querySelector(".fa-dock"), boot: p.querySelector(".fa-boot")};
    (PREVIEW_HOOKS[sid] || []).forEach(fn => { try { fn(p, ctx); } catch (e) { console.error("preview " + sid, e); } });
  });
}

function lookSet(sid, key, value) {
  A.current[sid][key] = value;
  const sec = A.schema.sections.find(s => s.id === sid);
  if (sec.fields.some(f => f.show_if && f.show_if.key === key)) {
    // Other fields depend on this one (show_if): draw again, and keep the focus on this control.
    const had = document.activeElement && document.activeElement.closest(`[data-look="${sid}"][data-key="${key}"]`);
    renderKeep();
    if (had) { const c = document.querySelector(`[data-look="${sid}"][data-key="${key}"] select, [data-look="${sid}"][data-key="${key}"] input`); if (c) c.focus(); }
    return;
  }
  document.querySelectorAll(`[data-look="${sid}"]`).forEach(row => {
    const f = sec.fields.find(x => x.key === row.dataset.key);
    row.hidden = !looksVisible(f, A.current[sid]);
    row.classList.toggle("changed", !same(A.current[sid][f.key], A.saved[sid][f.key]));
    row.classList.toggle("custom", !same(A.current[sid][f.key], f.default));
  });
  document.querySelectorAll(`[data-look-save="${sid}"]`).forEach(b => { b.disabled = !lookDirty(sid); });
  updatePreviews(); updateNav();
}

function lookControl(sid, f) {
  const v = A.current[sid][f.key], name = fLabel(sid, f);
  if (f.type === "toggle") {
    const input = el("input", {type: "checkbox", role: "switch", "aria-label": name});
    input.checked = v;
    input.addEventListener("change", () => lookSet(sid, f.key, input.checked));
    return el("label", {class: "switch"}, [input, el("span", {class: "knob"})]);
  }
  if (f.type === "select") {
    const input = el("select", {"aria-label": name});
    f.options.forEach(o => { const op = el("option", {value: o.value, text: fOpt(sid, f, o)}); if (o.value === v) op.selected = true; input.append(op); });
    input.addEventListener("change", () => lookSet(sid, f.key, input.value));
    return input;
  }
  if (f.type === "slider") {
    // The ends of the scale on both sides, and the value now after it.
    const input = el("input", {type: "range", "aria-label": name, min: f.min, max: f.max, step: f.step || 1});
    input.value = v;
    const unit = el("output", {class: "unit", text: v + " " + unitLabel(f.unit)});
    input.addEventListener("input", () => {
      const n = Number(input.value);
      unit.textContent = n + " " + unitLabel(f.unit);
      lookSet(sid, f.key, n);
    });
    return el("span", {class: "ctl"}, [el("span", {class: "lim", "aria-hidden": "true", text: String(f.min)}), input,
                                       el("span", {class: "lim", "aria-hidden": "true", text: String(f.max)}), unit]);
  }
  if (f.type === "number") {
    // Like the system number fields: an empty or unreadable value is never kept, out of range is brought in on leaving.
    const input = el("input", {type: "number", "aria-label": name, min: f.min, max: f.max, step: f.step || 1});
    input.value = v;
    const unit = el("span", {class: "unit", text: unitLabel(f.unit)});
    const read = () => { const raw = input.value.trim(), n = Number(raw); return raw === "" || input.validity.badInput || !Number.isFinite(n) ? null : n; };
    const ok = n => n !== null && (f.min === undefined || n >= f.min) && (f.max === undefined || n <= f.max);
    input.addEventListener("input", () => {
      const n = read();
      input.setAttribute("aria-invalid", String(!ok(n)));
      input.title = ok(n) ? "" : t("ui.num.range", {min: f.min, max: f.max});
      if (ok(n)) lookSet(sid, f.key, n);
    });
    input.addEventListener("blur", () => {
      let n = read();
      if (n === null) n = A.current[sid][f.key];
      else if (!ok(n)) n = Math.min(f.max, Math.max(f.min, n));
      input.value = n; input.setAttribute("aria-invalid", "false"); input.title = "";
      if (!same(n, A.current[sid][f.key])) lookSet(sid, f.key, n);
    });
    return el("span", {class: "ctl"}, [input, unit]);
  }
  if (f.type === "color") {
    const pick = el("input", {type: "color", "aria-label": name});
    const hex = el("input", {type: "text", class: "hex", "aria-label": t("ui.hex_of", {name}), maxlength: "7", spellcheck: "false"});
    pick.value = hex.value = v;
    pick.addEventListener("input", () => { hex.value = pick.value; lookSet(sid, f.key, pick.value); });
    const good = () => /^#[0-9a-fA-F]{6}$/.test(hex.value);
    hex.addEventListener("input", () => {
      hex.setAttribute("aria-invalid", String(!good()));
      hex.title = good() ? "" : t("ui.hex.bad");
      if (good()) { pick.value = hex.value.toLowerCase(); lookSet(sid, f.key, hex.value.toLowerCase()); }
    });
    hex.addEventListener("blur", () => {
      if (!good()) { hex.value = A.current[sid][f.key]; hex.setAttribute("aria-invalid", "false"); hex.title = ""; }
    });
    return el("span", {class: "ctl"}, [pick, hex]);
  }
  const ch = f.choices === "backend" ? (A.choices[sid] || {})[f.key] : null;
  if (f.type === "text" && ch && ch.choices.length) {
    // A list from the section's program (for example your Wallpaper Engine wallpapers). A saved value that is
    // not in the list any more stays shown, marked, so nothing changes without you choosing it.
    const input = el("select", {"aria-label": name});
    input.style.maxWidth = "280px";      // long titles must not squeeze the label
    const opts = [{value: "", label: t("ui.none_chosen")}].concat(ch.choices);
    if (v && !ch.choices.some(c => c.value === v)) opts.push({value: v, label: t("ui.not_found_now", {value: v})});
    opts.forEach(o => { const op = el("option", {value: o.value, text: o.label}); if (o.value === v) op.selected = true; input.append(op); });
    input.addEventListener("change", () => lookSet(sid, f.key, input.value));
    return input;
  }
  if (f.type === "text") {
    const input = el("input", {type: "text", "aria-label": name, maxlength: String(f.max_length || 256), spellcheck: "false",
                               placeholder: f.choices === "backend" ? t("ui.leave_as_is") : null});
    input.value = v;
    input.addEventListener("input", () => lookSet(sid, f.key, input.value));
    return input;
  }
  // media
  const item = mediaItem(v);
  const nameEl = el("div", {class: "mp-name" + (item ? "" : " none"), text: item ? item.name : t("ui.nothing_chosen")});
  const choose = el("button", {type: "button", class: "btn small", text: t("ui.choose_library")});
  choose.addEventListener("click", () => openPicker(sid, f));
  const up = el("button", {type: "button", class: "btn small", text: t("ui.upload")});
  up.addEventListener("click", () => pickFiles(f.accept, items => {
    const ok = items.find(i => ACCEPT[f.accept].includes(i.kind));
    if (ok) { A.current[sid][f.key] = ok.id; renderKeep(); lookSet(sid, f.key, ok.id); }
  }, sid + "." + f.key));
  const clear = el("button", {type: "button", class: "btn small", text: t("ui.clear"), disabled: !item});
  clear.addEventListener("click", () => { lookSet(sid, f.key, ""); renderKeep(); });
  return el("div", {class: "media-pick"}, [thumb(item, ""),
    el("div", {}, [nameEl, el("div", {class: "help", text: item ? kindLabel(item.kind) + ", " + size(item.size) : ""}),
                   el("div", {class: "mp-acts"}, [choose, up, clear]),
                   el("div", {class: "mp-status", role: "status", "data-status": sid + "." + f.key})])]);
}

function lookRow(sid, f) {
  const vals = A.current[sid];
  const defOpt = f.type === "select" ? (f.options.find(o => o.value === f.default) || null) : null;
  const reset = el("button", {type: "button", class: "reset", text: t("ui.reset"),
                              title: t("ui.reset.title", {value: defOpt ? fOpt(sid, f, defOpt) : f.default === "" ? t("ui.none") : fmt(f.default)})});
  reset.addEventListener("click", () => { lookSet(sid, f.key, f.default); renderKeep(); });
  const label = el("div", {class: "label"}, [el("span", {class: "dot", title: t("ui.unsaved_dot")}), el("span", {text: fLabel(sid, f)})]);
  if (f.advanced) label.append(el("span", {class: "pill", text: t("ui.advanced")}));
  const info = el("div", {}, [label]);
  if (f.help) info.append(el("div", {class: "help", text: fHelp(sid, f)}));
  const ch = f.choices === "backend" ? (A.choices[sid] || {})[f.key] : null;
  if (ch && ch.note) info.append(el("div", {class: "help", text: tr(ch.note)}));
  if (f.tags && query()) info.append(tagButtons(f.tags));
  const media = f.type === "media";
  const row = el("div", {class: "row" + (media ? " stack" : "") + (!same(vals[f.key], A.saved[sid][f.key]) ? " changed" : "")
                         + (!same(vals[f.key], f.default) ? " custom" : ""), "data-look": sid, "data-key": f.key,
                         hidden: !looksVisible(f, vals)},
                 media ? [el("div", {class: "ctl"}, [info, reset]), lookControl(sid, f)]
                       : [info, el("div", {class: "ctl"}, [reset, lookControl(sid, f)])]);
  if (media) row.firstChild.style.justifyContent = "space-between";
  return row;
}

function lookFooter(sid) {
  const sec = A.schema.sections.find(s => s.id === sid);
  const out = el("pre", {class: "out", role: "status"});
  const installed = A.backends[sid];
  const note = el("div", {class: "note", text: installed ? t("ui.look.note")
                         : t("ui.look.note_missing", {name: lookSecLabel(sec)})});
  const save = el("button", {type: "button", class: "btn" + (installed ? "" : " primary"), text: t("ui.save"), "data-look-save": sid,
                             disabled: !lookDirty(sid)});
  save.addEventListener("click", () => lookSave(sid, false, out));
  const kids = [note, save];
  if (installed) {
    const apply = el("button", {type: "button", class: "btn primary", text: t("ui.save_apply")});
    apply.addEventListener("click", () => lookSave(sid, true, out));
    kids.push(apply);
  }
  kids.push(out);
  return el("div", {class: "look-foot"}, kids);
}

async function lookSave(sid, apply, out) {
  out.className = "out"; out.textContent = apply ? t("ui.saving_applying") : t("ui.saving");
  const foot = out.closest(".look-foot");
  if (foot) foot.querySelectorAll("button").forEach(b => { b.disabled = true; b.setAttribute("aria-busy", "true"); });
  try {
    const r = await (await fetch("/api/appearance/save", {method: "POST", headers: H,
                                 body: JSON.stringify({values: {[sid]: A.current[sid]}})})).json();
    if (!r.ok) { out.className = "out bad"; out.textContent = tr(r.output); return; }
    A.saved = JSON.parse(JSON.stringify(r.values));
    A.current[sid] = JSON.parse(JSON.stringify(r.values[sid]));
    loadChoices(sid);
    let text = t("ui.saved");
    if (apply) {
      const a = await (await fetch("/api/appearance/apply", {method: "POST", headers: H, body: JSON.stringify({section: sid})})).json();
      const res = (a.results || [])[0] || {};
      text = res.state === "applied" ? t("ui.saved_applied") : res.state === "not-installed" ? t("ui.saved_not_installed")
           : t("ui.saved_apply_failed");
      if (res.output) text += "\n" + tr(res.output);
      out.className = "out " + (res.state === "failed" || !a.ok ? "bad" : "ok");
    } else out.className = "out ok";
    renderKeep();
    // The result box was replaced by the new render: show it in the new one.
    const fresh = document.querySelector(`#look-${sid} .look-foot .out`) || out;
    fresh.className = out.className; fresh.textContent = text;
  } catch (e) { out.className = "out bad"; out.textContent = t("ui.closed"); }
}

function lookSection(sec, fields) {
  // Whether it can be applied yet is said once, next to the Save button (lookFooter).
  const head = el("div", {class: "look-head"}, [el("h3", {id: "lh-" + sec.id, text: lookSecLabel(sec)})]);
  if (sec.help) head.append(el("p", {text: lookSecHelp(sec)}));
  const card = el("div", {class: "card"});
  const q = query();
  const always = f => !f.advanced || q || !same(A.current[sec.id][f.key], f.default) || lookDirty(sec.id) && !same(A.current[sec.id][f.key], A.saved[sec.id][f.key]);
  const advKey = "look-" + sec.id;
  const rest = fields.filter(f => !always(f));
  const folded = rest.filter(f => looksVisible(f, A.current[sec.id]));
  if (!sec.fields.length) card.append(el("div", {class: "empty", text: t("ui.look.empty", {name: lookSecLabel(sec)})}));
  fields.forEach(f => { if (always(f)) card.append(lookRow(sec.id, f)); });
  if (fields.length && card.firstChild) card.firstChild.style.borderTop = "0";
  if (folded.length) card.append(...foldAway(advKey, rest.map(f => lookRow(sec.id, f)), folded.length));
  else rest.forEach(f => card.append(lookRow(sec.id, f)));   // only hidden ones: they show when what they depend on changes
  if (sec.fields.length) card.append(lookFooter(sec.id));
  const prev = el("div", {class: "prev"}, [previewEl(sec.id), el("p", {class: "cap", text: t("ui.look.preview_cap")})]);
  return el("section", {class: "look", id: "look-" + sec.id, "aria-labelledby": "lh-" + sec.id},
            [head, el("div", {class: "look-body"}, [prev, card])]);
}

function libraryCard() {
  const used = A.caps.used || 0, total = A.caps.total || 1;
  const track = el("div", {class: "track"}, [el("i")]);
  track.firstChild.style.width = Math.min(100, used / total * 100).toFixed(1) + "%";
  const add = el("button", {type: "button", class: "btn", text: t("ui.lib.add")});
  add.addEventListener("click", () => pickFiles("any"));
  const card = el("section", {class: "card", id: "library", "aria-labelledby": "lib-h"}, [
    el("h3", {id: "lib-h", text: t("ui.lib.title")}),
    el("div", {class: "sub", text: t("ui.lib.sub", {folder: A.mediaDir || t("ui.lib.home")})}),
    el("div", {class: "lib-top"}, [el("div", {class: "meter"}, [track,
      el("div", {class: "t", text: t("ui.lib.used", {used: size(used), total: size(total), file: size(A.caps.file || 0)})})]), add]),
    el("div", {class: "progress", id: "lib-progress", role: "status"}),
  ]);
  if (A.problem) card.append(el("div", {class: "error", role: "alert", text: tr(A.problem.charAt(0).toUpperCase() + A.problem.slice(1) + ".")}));
  if (!A.media.length) {
    card.append(el("div", {class: "empty", text: t("ui.lib.empty")}));
    return card;
  }
  const grid = el("div", {class: "lib-grid"});
  A.media.forEach(m => {
    const rm = el("button", {type: "button", class: "btn small danger", text: t("ui.remove"), "aria-label": t("ui.remove_name", {name: m.name})});
    rm.addEventListener("click", () => removeMedia(m));
    grid.append(el("div", {class: "tile"}, [thumb(m), el("div", {class: "nm", title: m.name, text: m.name}),
      el("div", {class: "meta"}, [el("span", {text: size(m.size)}), rm])]));
  });
  card.append(grid);
  return card;
}

async function removeMedia(m) {
  if (!await ask({title: t("ui.remove_name", {name: m.name}), body: t("ui.lib.remove_confirm", {name: m.name}), ok: t("ui.remove"), danger: true})) return;
  const r = await (await fetch("/api/appearance/media/remove", {method: "POST", headers: H, body: JSON.stringify({id: m.id})})).json();
  A.status = {text: r.ok ? t("ui.lib.removed", {name: m.name}) : t("ui.lib.not_removed", {why: r.media_problem ? tr(r.media_problem) : t("ui.lib.gone")}),
              where: null};
  A.problem = r.media_problem;
  if (r.ok) {
    A.media = r.media;
    A.caps.used = A.media.reduce((n, x) => n + x.size, 0);
    // Values that pointed at it were reset on disk; reset them here too, keep other unsaved changes.
    A.schema.sections.forEach(s => s.fields.forEach(f => {
      if (f.type === "media" && A.current[s.id][f.key] === m.id) A.current[s.id][f.key] = r.values[s.id][f.key];
      if (f.type === "media" && A.saved[s.id][f.key] === m.id) A.saved[s.id][f.key] = r.values[s.id][f.key];
    }));
  }
  renderKeep();
}

// Uploads: streamed to forge-settings, which checks the bytes and copies it into your library.
let pickCallback = null, pickWhere = null;
function pickFiles(accept, done, where) {
  const input = $("#mediafile");
  input.accept = PICK[accept] || PICK.any;
  pickCallback = done || null;
  pickWhere = where || null;
  input.value = "";
  input.click();
}
$("#mediafile").addEventListener("change", async () => {
  const files = [...$("#mediafile").files], done = pickCallback, where = pickWhere;
  pickCallback = pickWhere = null;
  A.status.where = where;
  const added = [];
  for (const f of files) {
    const item = await uploadOne(f);
    if (item) added.push(item);
  }
  if (added.length) {
    A.media = await (await fetch("/api/appearance/media", {headers: H})).json();
    A.caps.used = A.media.reduce((n, x) => n + x.size, 0);
  }
  if (done) done(added);
  if ($("#picker").open) fillPicker(); else renderKeep();
});

// The upload message, with a progress bar for the file being sent (pct is null when none is on the way).
function status(text, pct) {
  A.status.text = text;
  A.status.pct = pct === undefined ? null : pct;
  drawStatus();
}
function statusKids() {
  if (!A.status.text) return [];
  const kids = [document.createTextNode(A.status.text)];
  if (A.status.pct !== null && A.status.pct !== undefined) {
    const bar = el("i");
    bar.style.transform = "scaleX(" + Math.max(0, Math.min(100, A.status.pct)) / 100 + ")";
    kids.push(el("div", {class: "pbar", "aria-hidden": "true"}, [bar]));
  }
  return kids;
}
function drawStatus() {
  [$("#lib-progress"), $("#pk-progress")].forEach(p => { if (p) p.replaceChildren(...statusKids()); });
  document.querySelectorAll(".mp-status").forEach(p => {
    p.replaceChildren(...(p.dataset.status === A.status.where ? statusKids() : []));
  });
}

function uploadOne(file) {
  return new Promise(resolve => {
    if (A.caps.file && file.size > A.caps.file) { status(t("ui.up.too_big", {name: file.name, size: size(A.caps.file)})); return resolve(null); }
    const x = new XMLHttpRequest();
    x.open("POST", "/api/appearance/upload?name=" + encodeURIComponent(file.name));
    x.setRequestHeader("X-Forge-Token", TOKEN);
    x.setRequestHeader("Content-Type", "application/octet-stream");
    x.upload.addEventListener("progress", e => {
      if (e.lengthComputable) { const pct = Math.floor(e.loaded / e.total * 100); status(t("ui.up.progress", {name: file.name, pct}), pct); }
    });
    x.addEventListener("load", () => {
      let d = {};
      try { d = JSON.parse(x.responseText); } catch (e) { d = {output: t("ui.up.odd")}; }
      status(d.ok ? t("ui.up.added", {name: d.item.name}) : file.name + ": " + (d.output ? tr(d.output) : t("ui.up.not_added")));
      resolve(d.ok ? d.item : null);
    });
    x.addEventListener("error", () => { status(t("ui.up.not_sent", {name: file.name})); resolve(null); });
    status(t("ui.up.adding", {name: file.name}), 0);
    x.send(file);
  });
}

// The media picker dialog
let picking = null;
function openPicker(sid, f) {
  picking = {sid, f, chosen: A.current[sid][f.key]};
  A.status = {text: "", where: null};
  $("#pk-title").textContent = t("ui.pick.choose", {name: fLabel(sid, f)});
  $("#pk-sub").textContent = f.accept === "video" ? t("ui.pick.videos") : f.accept === "image" ? t("ui.pick.pictures") : t("ui.pick.both");
  status("");
  fillPicker();
  $("#picker").showModal();
}
function fillPicker() {
  const grid = $("#pk-grid");
  grid.replaceChildren();
  const items = A.media.filter(m => ACCEPT[picking.f.accept].includes(m.kind));
  if (!items.length) grid.append(el("div", {class: "nomatch", text: t("ui.pick.empty")}));
  items.forEach(m => {
    const b = el("button", {type: "button", class: "pick tile", "aria-pressed": String(m.id === picking.chosen)},
                 [thumb(m), el("div", {class: "nm", title: m.name, text: m.name}), el("div", {class: "meta", text: size(m.size)})]);
    b.addEventListener("click", () => { picking.chosen = m.id; fillPicker(); });
    b.addEventListener("dblclick", () => { picking.chosen = m.id; usePick(); });
    grid.append(b);
  });
  $("#pk-ok").disabled = !picking.chosen || !mediaItem(picking.chosen);
}
function usePick() {
  $("#picker").close();
  lookSet(picking.sid, picking.f.key, picking.chosen);
  renderKeep();
}
$("#pk-ok").addEventListener("click", usePick);
$("#pk-cancel").addEventListener("click", () => $("#picker").close());
$("#pk-upload").addEventListener("click", () => pickFiles(picking.f.accept, items => {
  const ok = items.find(i => ACCEPT[picking.f.accept].includes(i.kind));
  if (ok) picking.chosen = ok.id;
}, picking.sid + "." + picking.f.key));

// Presets: your whole look under a name (forgepresets on the server). Applying runs every section's program.

const P = {list: [], sync: {configured: false, message: null}, out: {text: "", ok: true}, pending: null};
const when = ts => new Date(ts * 1000).toLocaleDateString(I18N.lang === "th" ? "th-TH" : undefined, {dateStyle: "medium"});

async function loadPresets() {
  try {
    const d = await (await fetch("/api/appearance/presets", {headers: H})).json();
    P.list = d.presets || []; P.sync = d.sync || P.sync;
  } catch (e) { /* the rest of the page still works */ }
}
function presetOut(ok, text) { P.out = {ok, text}; const o = $("#ps-out"); if (o) { o.className = "out " + (ok ? "ok" : "bad"); o.textContent = text; } }

function presetMini(p) {
  const L = p.look || {};
  const box = el("div", {class: "ps-mini", "aria-hidden": "true"});
  if (L.color) box.style.background = L.color;
  if (L.picture && mediaItem(L.picture) && mediaItem(L.picture).format !== "svg" && mediaItem(L.picture).kind !== "video")
    box.append(el("img", {alt: "", loading: "lazy", src: mediaUrl(L.picture)}));
  const w = el("div", {class: "w" + (L.scheme === "dark" ? " dark" : "")}, [el("i")]);
  if (L.accent) w.firstChild.style.background = L.accent;
  box.append(w, el("div", {class: "d " + (L.dock || "default")}));
  return box;
}

function presetTile(p) {
  const apply = el("button", {type: "button", class: "btn small primary", text: t("preset.apply")});
  apply.addEventListener("click", () => askApply(p));
  const ren = el("button", {type: "button", class: "btn small", text: t("preset.rename"), "aria-label": t("preset.rename_name", {name: p.name})});
  ren.addEventListener("click", async () => {
    const name = await ask({title: t("preset.rename_name", {name: p.name}), ok: t("preset.rename"),
                            input: {label: t("preset.rename.prompt"), value: p.name, max: 60}});
    if (name === false) return;
    const r = await presetPost("rename", {id: p.id, name});
    if (r.ok) presetOut(true, t("preset.renamed", {name: r.preset.name}));
  });
  const exp = el("button", {type: "button", class: "btn small", text: t("preset.export"), "aria-label": t("preset.export_name", {name: p.name})});
  exp.addEventListener("click", () => exportPreset(p));
  const del = el("button", {type: "button", class: "btn small danger", text: t("preset.delete"), "aria-label": t("preset.delete_name", {name: p.name})});
  del.addEventListener("click", async () => {
    if (!await ask({title: t("preset.delete_name", {name: p.name}), ok: t("preset.delete"), danger: true,
                    body: t(p.origin === "sync" ? "preset.delete.confirm_synced" : "preset.delete.confirm", {name: p.name})})) return;
    const r = await presetPost("delete", {id: p.id});
    if (r.ok) presetOut(true, t("preset.deleted", {name: p.name}));
  });
  const meta = t("preset.saved_on", {date: when(p.updated)}) + (p.media_count ? ", " + tn("preset.files", p.media_count) : "");
  return el("div", {class: "ps", "data-preset": p.id}, [presetMini(p), el("div", {class: "nm", text: p.name}),
    el("div", {class: "meta", text: meta}), el("div", {class: "acts"}, [apply, ren, exp, del])]);
}

function presetsCard() {
  const name = el("input", {type: "text", id: "ps-name", maxlength: "60", spellcheck: "false", "aria-label": t("preset.name.aria"),
                            placeholder: t("preset.name.placeholder")});
  const save = el("button", {type: "button", class: "btn primary", text: t("preset.save"), disabled: true});
  const named = () => !!name.value.trim();
  name.addEventListener("input", () => { save.disabled = !named(); });
  const doSave = async () => {
    if (!named()) return;
    save.disabled = true; save.classList.add("busy"); save.setAttribute("aria-busy", "true");
    const r = await presetPost("save", {name: name.value});
    if (r.ok) presetOut(true, t("preset.saved", {name: r.preset.name}));
  };
  save.addEventListener("click", doSave);
  name.addEventListener("keydown", e => { if (e.key === "Enter") doSave(); });
  const imp = el("button", {type: "button", class: "btn small", text: t("preset.import")});
  imp.addEventListener("click", () => { $("#presetfile").value = ""; $("#presetfile").click(); });
  const tools = [el("span", {class: "sp", text: !P.sync.configured ? t("preset.sync.off")
                             : P.sync.reduced ? t("preset.sync.on") + " " + t("preset.sync.reduced") : t("preset.sync.on")}), imp];
  if (P.sync.configured) {
    const sync = el("button", {type: "button", class: "btn small", text: t("preset.sync")});
    sync.addEventListener("click", syncPresets);
    tools.push(sync);
  }
  const out = el("pre", {class: "out" + (P.out.text ? (P.out.ok ? " ok" : " bad") : ""), id: "ps-out", role: "status", text: P.out.text});
  const card = el("div", {class: "card"}, [el("div", {class: "ps-save"}, [name, save]), el("div", {class: "ps-tools"}, tools)]);
  if (P.out.text) card.append(el("div", {class: "ps-tools"}, [out])); else card.append(out);
  card.append(P.list.length ? el("div", {class: "ps-grid"}, P.list.map(presetTile))
                            : el("div", {class: "empty", text: t("preset.empty")}));
  return el("section", {class: "presets", id: "presets", "aria-labelledby": "ps-h"}, [
    el("div", {class: "look-head"}, [el("h3", {id: "ps-h", text: t("preset.title")}), el("p", {text: t("preset.help")})]), card]);
}

async function presetPost(action, body) {
  let r;
  try {
    r = await (await fetch("/api/appearance/presets/" + action, {method: "POST", headers: H, body: JSON.stringify(body || {})})).json();
  } catch (e) { r = {ok: false, output: t("ui.closed")}; }
  if (!r.ok && action !== "apply") presetOut(false, tr(r.output || t("preset.failed")));
  await loadPresets();
  renderKeep();
  return r;
}

function askApply(p) {
  P.pending = p;
  $("#ps-d-title").textContent = t("preset.apply.title", {name: p.name});
  $("#ps-d-body").textContent = t("preset.apply.body");
  $("#ps-d-sys").hidden = !p.system;
  $("#ps-d-check").checked = false;
  $("#ps-d-notes").replaceChildren();
  $("#ps-dialog").showModal();
}
$("#ps-d-cancel").addEventListener("click", () => $("#ps-dialog").close());
$("#ps-d-ok").addEventListener("click", async () => {
  const p = P.pending, system = !$("#ps-d-sys").hidden && $("#ps-d-check").checked;
  $("#ps-dialog").close();
  if (!p) return;
  presetOut(true, system ? t("preset.applying_admin") : t("preset.applying"));
  const r = await presetPost("apply", {id: p.id, system});
  const lines = [];
  (r.results || []).forEach(x => {
    const sec = A.schema.sections.find(s => s.id === x.section);
    const name = sec ? lookSecLabel(sec) : x.section;
    lines.push(name + ": " + t("preset.state." + (x.state === "applied" ? "applied" : x.state === "not-installed" ? "missing" : "failed"))
               + (x.output && x.state !== "not-installed" ? "\n  " + tr(x.output).replace(/\n/g, "\n  ") : ""));
  });
  (r.notes || []).forEach(n => lines.push(tr(n)));
  presetOut(!!r.ok, (r.ok ? t("preset.applied", {name: p.name}) : r.results ? t("preset.applied_some", {name: p.name}) : tr(r.output || t("preset.failed")))
            + (lines.length ? "\n" + lines.join("\n") : ""));
  if (r.values) {
    const done = r.values;
    A.schema.sections.forEach(s => { A.saved[s.id] = JSON.parse(JSON.stringify(done[s.id])); A.current[s.id] = JSON.parse(JSON.stringify(done[s.id])); });
    A.schema.sections.forEach(s => loadChoices(s.id));
    renderKeep();
  }
});

async function exportPreset(p) {
  presetOut(true, t("preset.exporting", {name: p.name}));
  try {
    const r = await fetch("/api/appearance/presets/export?id=" + encodeURIComponent(p.id), {headers: {"X-Forge-Token": TOKEN}});
    if (!r.ok) throw new Error();
    const m = /filename="([^"]+)"/.exec(r.headers.get("Content-Disposition") || "");
    const a = el("a", {href: URL.createObjectURL(await r.blob()), download: m ? m[1] : "preset.forgelook"});
    document.body.append(a); a.click(); a.remove();
    presetOut(true, t("preset.exported", {name: p.name}));
  } catch (e) { presetOut(false, t("preset.export_failed")); }
}

$("#presetfile").addEventListener("change", () => {
  const file = $("#presetfile").files[0];
  if (!file) return;
  const x = new XMLHttpRequest();
  x.open("POST", "/api/appearance/presets/import");
  x.setRequestHeader("X-Forge-Token", TOKEN);
  x.setRequestHeader("Content-Type", "application/octet-stream");
  x.upload.addEventListener("progress", e => {
    if (e.lengthComputable) presetOut(true, t("preset.importing_pct", {name: file.name, pct: Math.floor(e.loaded / e.total * 100)}));
  });
  x.addEventListener("load", async () => {
    let d = {};
    try { d = JSON.parse(x.responseText); } catch (e) { d = {ok: false, output: t("ui.up.odd")}; }
    presetOut(!!d.ok, d.ok ? t("preset.imported", {name: d.preset.name}) : tr(d.output || t("preset.failed")));
    await loadPresets();
    A.media = await (await fetch("/api/appearance/media", {headers: H})).json();
    A.caps.used = A.media.reduce((n, m) => n + m.size, 0);
    renderKeep();
  });
  x.addEventListener("error", () => presetOut(false, t("preset.import_not_sent", {name: file.name})));
  presetOut(true, t("preset.importing", {name: file.name}));
  x.send(file);
});

async function syncPresets() {
  presetOut(true, t("preset.syncing"));
  let r;
  try { r = await (await fetch("/api/appearance/presets/sync", {method: "POST", headers: H, body: "{}"})).json(); }
  catch (e) { r = {ok: false, output: t("ui.closed")}; }
  const text = r.ok ? t("preset.synced", {sent: r.sent, received: r.received}) + (r.reduced ? "\n" + t("preset.sync.reduced") : "") + (r.skipped && r.skipped.length ? "\n" + r.skipped.map(tr).join("\n") : "")
             : tr(r.output || t("preset.failed"));
  presetOut(!!r.ok, text);
  await loadPresets();
  if (r.received) A.media = await (await fetch("/api/appearance/media", {headers: H})).json();
  renderKeep();
}

// Pages

function appearancePage() {
  const box = [presetsCard()];
  A.schema.sections.forEach(sec => box.push(lookSection(sec, sec.fields)));
  if (!A.schema.sections.length) box.push(el("div", {class: "card"}, [el("div", {class: "empty", text: t("ui.look.none")})]));
  box.push(libraryCard());
  return box;
}

function header(title, text) {
  return el("div", {class: "ph"}, [el("h2", {id: "page-title", tabindex: "-1", text: title}), el("p", {text: text})]);
}

function resultsPage(q) {
  const out = [];
  let n = 0;
  A.schema.sections.forEach(sec => {
    const fields = sec.fields.filter(f => matches(f, q, sec.label + " " + lookSecLabel(sec), fLabel(sec.id, f) + " " + fHelp(sec.id, f)));
    if (!fields.length) return;
    n += fields.length;
    out.push(lookSection(sec, fields));
  });
  SECTIONS.forEach(S => groupsIn(S.id).forEach(g => {
    const items = schema.settings.filter(s => s.group === g.id && matches(s, q, g.label + " " + groupLabel(g), setLabel(s) + " " + setHelp(s)));
    if (!items.length) return;
    n += items.length;
    const card = groupCard(g, items, q);
    card.firstChild.append(el("small", {text: secLabel(S)}));
    out.push(card);
  }));
  const head = header(t("ui.search.title"), n ? tn("ui.search.found", n, {q: $("#search").value.trim()}) : t("ui.search.none"));
  return [head, ...out];
}

function counts(q) {
  const c = {};
  SECTIONS.forEach(S => {
    c[S.id] = S.id === "appearance" ? A.schema.sections.reduce((n, s) => n + s.fields.filter(f => matches(f, q, s.label + " " + lookSecLabel(s), fLabel(s.id, f) + " " + fHelp(s.id, f))).length, 0)
      : groupsIn(S.id).reduce((n, g) => n + schema.settings.filter(s => s.group === g.id && matches(s, q, g.label + " " + groupLabel(g), setLabel(s) + " " + setHelp(s))).length, 0);
  });
  return c;
}

function updateNav() {
  const q = query(), c = counts(q), nav = $("#nav");
  nav.replaceChildren();
  SECTIONS.forEach(S => {
    const dirty = S.id === "appearance" ? A.schema.sections.some(s => lookDirty(s.id))
      : groupsIn(S.id).some(g => schema.settings.some(s => s.group === g.id && !same(current[s.key], saved[s.key])));
    const a = el("a", {href: "#" + S.id, class: q && c[S.id] ? "hit" : null, title: secLabel(S),
                       "aria-current": !q && page === S.id ? "page" : null},
                 [el("span", {class: "n", text: secLabel(S)})]);
    if (q) a.append(el("span", {class: "cnt", text: String(c[S.id]), "aria-label": tn("ui.nav.matches", c[S.id])}));
    else if (dirty) a.append(el("span", {class: "dot", title: t("ui.nav.unsaved")}));
    a.addEventListener("click", e => {
      if (!query()) return;
      $("#search").value = "";
      clearTimeout(searchTimer);
      if (location.hash === "#" + S.id) {          // no hashchange will come: show the page now
        e.preventDefault(); switchPage();
      }
    });
    nav.append(a);
  });
}

// Where the system settings live and which Forge OS this is: on the Data page, out of the way of the save bar.
const INFO = {file: "", version: ""};
function aboutCard() {
  const rows = [el("dt", {text: t("ui.about.file")}), el("dd", {}, [el("code", {id: "file", text: INFO.file})])];
  if (INFO.version) rows.push(el("dt", {text: t("ui.about.version")}), el("dd", {text: "Forge OS " + tr(INFO.version)}));
  return el("section", {class: "card", id: "about", "aria-labelledby": "about-h"},
            [el("h3", {id: "about-h", text: t("ui.about.title")}), el("dl", {class: "about"}, rows)]);
}

function render(keepScroll) {
  if (!schema) return;
  const q = query(), y = window.scrollY;
  const content = $("#content");
  let kids;
  if (q) kids = resultsPage(q);
  else if (page === "appearance") kids = [header(secLabel(SECTIONS[0]), secHelp(SECTIONS[0])), ...appearancePage()];
  else {
    const S = SECTIONS.find(s => s.id === page);
    kids = [header(secLabel(S), secHelp(S)), ...groupsIn(page).map(g => groupCard(g, schema.settings.filter(s => s.group === g.id), ""))];
    if (page === "data") kids.push(aboutCard());
  }
  content.replaceChildren(...kids);
  updateNav(); updatePreviews(); updateBar(); drawStatus();
  if (keepScroll) window.scrollTo(0, y);
}
const renderKeep = () => render(true);

function go() {
  const want = (location.hash || "").slice(1);
  const hasLook = A.schema.sections.some(s => s.fields.length);
  page = SECTIONS.some(s => s.id === want) ? want : hasLook ? "appearance" : "system";
  render();
  window.scrollTo(0, 0);
}
// A new page: a short crossfade where the browser can (and you did not ask for less motion), back to the top,
// and the keyboard focus on its heading, shown, so you know where you are.
function switchPage() {
  if (!schema) return;
  const run = () => { go(); const h = $("#page-title"); if (h) h.focus({focusVisible: true}); };
  if (document.startViewTransition && !still()) document.startViewTransition(run); else run();
}
window.addEventListener("hashchange", switchPage);

// System settings: unsaved changes, save, undo, import and export (unchanged behaviour)

function set(key, value, rerender) {
  current[key] = value;
  if (rerender) return renderKeep();
  const s = schema.settings.find(x => x.key === key);
  document.querySelectorAll(`.row[data-key="${CSS.escape(key)}"]:not([data-look]), .cell[data-key="${CSS.escape(key)}"]`).forEach(r => {
    r.classList.toggle("changed", !same(value, saved[key]));
    r.classList.toggle("custom", !same(value, s.default));
  });
  updateBar(); updateNav();
}

function changes() { return Object.keys(current).filter(k => !same(current[k], saved[k])); }

function updateBar() {
  const n = changes().length;
  const busy = $("#save").classList.contains("busy");
  $("#save").disabled = n === 0 || busy;
  $("#discard").disabled = n === 0 || busy;
  $("#count").replaceChildren(n ? el("b", {text: tn("ui.bar.changes", n)}) : document.createTextNode(t("ui.bar.none")));
  // Appearance saves on its own, so the bar only shows there when system settings wait to be saved.
  $("#bar").hidden = page === "appearance" && !query() && n === 0;
}

function show(ok, text) { toast(ok, ok ? t("ui.saved_applied") : t("ui.not_applied"), text ? tr(text) : ""); }
function note(ok, text) { toast(ok, text); updateBar(); }

async function load() {
  const r = await fetch("/api/settings", {headers: H});
  if (!r.ok) throw new Error("HTTP " + r.status);
  const d = await r.json();
  schema = d.schema; saved = {...d.values}; current = {...d.values};
  INFO.file = d.file || ""; INFO.version = d.forge_version || "";
  $("#undo").disabled = !d.can_undo;
}

async function loadLook() {
  try {
    const d = await (await fetch("/api/appearance", {headers: H})).json();
    A.schema = d.schema; A.saved = d.values; A.current = JSON.parse(JSON.stringify(d.values));
    A.media = d.media; A.backends = d.backends; A.caps = d.caps; A.mediaDir = d.media_dir; A.problem = d.media_problem;
    A.schema.sections.forEach(s => loadChoices(s.id));
    await loadPresets();
  } catch (e) { /* the system settings still work without it */ }
}

// Lists for text fields with "choices": "backend". Until they arrive (or without one) the field is a text box.
async function loadChoices(sid) {
  const sec = A.schema.sections.find(s => s.id === sid);
  if (!sec || !A.backends[sid] || !sec.fields.some(f => f.choices === "backend")) return;
  try {
    const d = await (await fetch("/api/appearance/choices?section=" + encodeURIComponent(sid), {headers: H})).json();
    if (d.ok) { A.choices[sid] = d.fields; if (page === "appearance" || query()) renderKeep(); }
  } catch (e) { /* keep the text box */ }
}

// Save shows that it is working (a spinner, aria-busy) and says "Saved" only once forge-apply answered.
async function post(path, body) {
  const b = $("#save");
  b.classList.add("busy"); b.setAttribute("aria-busy", "true"); b.disabled = true; $("#discard").disabled = true;
  b.textContent = t("ui.applying");
  try {
    const r = await fetch(path, {method: "POST", headers: H, body: JSON.stringify(body || {})});
    const d = await r.json(); show(d.ok, d.output); if (d.ok) await load();
  } catch (e) { show(false, String(e)); }
  b.classList.remove("busy"); b.removeAttribute("aria-busy");
  b.textContent = t("ui.save_apply");
  renderKeep();
}

// Changing the update channel switches the system image (forge-apply does it, as root). Never without a yes here.
async function channelConfirmed() {
  const ch = current["updates.channel"];
  if (ch === saved["updates.channel"]) return null;
  const back = ch === "testing" ? "stable" : "testing";
  const ok = await ask({title: t("ui.channel.ask", {channel: optLabel(ch)}), ok: t("ui.channel.switch"),
                        body: [ch === "testing" ? t("ui.channel.testing") : "", t("ui.channel.download"),
                               t("ui.channel.back", {channel: optLabel(back)})]});
  return ok ? ch : false;
}
$("#save").addEventListener("click", async () => {
  const sw = await channelConfirmed();
  if (sw === false) return note(false, t("ui.channel.cancelled"));
  post("/api/save", sw ? {values: current, switch_channel: sw} : {values: current});
});
$("#discard").addEventListener("click", () => { current = {...saved}; renderKeep(); });

// Export, import and undo live in the "More" menu of the save bar.
const menu = $("#more-menu"), more = $("#more");
function menuOpen(open) {
  menu.hidden = !open;
  more.setAttribute("aria-expanded", String(open));
  if (open) { const first = menu.querySelector("button:not(:disabled)"); if (first) first.focus(); }
}
more.addEventListener("click", () => menuOpen(menu.hidden));
document.addEventListener("click", e => { if (!menu.hidden && !e.target.closest(".menu-wrap")) menuOpen(false); });
menu.addEventListener("keydown", e => {
  const items = [...menu.querySelectorAll("button:not(:disabled)")], i = items.indexOf(document.activeElement);
  if (e.key === "Escape") { e.preventDefault(); menuOpen(false); more.focus(); }
  else if (e.key === "ArrowDown" || e.key === "ArrowUp") {
    e.preventDefault();
    const next = items[(i + (e.key === "ArrowDown" ? 1 : items.length - 1)) % items.length];
    if (next) next.focus();
  } else if (e.key === "Tab") menuOpen(false);
});
menu.querySelectorAll("button").forEach(b => b.addEventListener("click", () => menuOpen(false)));

$("#undo").addEventListener("click", async () => {
  if (await ask({title: t("ui.undo.ask"), body: t("ui.undo.ask_body"), ok: t("ui.undo")})) post("/api/undo");
});
$("#export").addEventListener("click", async () => {
  let d;
  try { d = await (await fetch("/api/export?portable=1", {headers: H})).json(); }
  catch (e) { return note(false, t("ui.not_exported") + "\n" + t("ui.closed")); }
  if (d.error) return note(false, t("ui.not_exported") + "\n" + tr(d.error));
  const name = "forge-settings-" + d.from_host + ".json";
  const a = el("a", {href: URL.createObjectURL(new Blob([JSON.stringify(d, null, 2)], {type: "application/json"})), download: name});
  document.body.append(a); a.click(); a.remove();
  toast(true, t("ui.exported", {name}));
});
$("#import").addEventListener("click", () => $("#importfile").click());
$("#importfile").addEventListener("change", async () => {
  const f = $("#importfile").files[0]; $("#importfile").value = "";
  if (!f) return;
  const r = await fetch("/api/import-check", {method: "POST", headers: H, body: JSON.stringify({text: await f.text()})});
  const d = await r.json();
  if (!d.ok) return note(false, tr(d.output));
  Object.assign(current, d.values); renderKeep();
  note(true, tn("ui.import.loaded", changes().length, {name: f.name}) + (d.notes.length ? "\n" + d.notes.map(tr).join("\n") : ""));
});

// Search runs a moment after you stop typing (120 ms), not on every key.
let searchTimer = 0;
function searchNow() {
  clearTimeout(searchTimer);
  render();
  const q = query();
  if (q) announce($("#page-title") && $("#page-title").nextSibling ? $("#page-title").nextSibling.textContent : "");
}
$("#search").addEventListener("input", () => { clearTimeout(searchTimer); searchTimer = setTimeout(searchNow, 120); });
$("#search").addEventListener("keydown", e => { if (e.key === "Escape") { $("#search").value = ""; searchNow(); } });
document.addEventListener("keydown", e => {
  if (e.key === "/" && !/^(INPUT|SELECT|TEXTAREA)$/.test(document.activeElement.tagName) && !document.querySelector("dialog[open]")) {
    e.preventDefault(); $("#search").focus();
  }
});
let dashTimer = 0;
$("#dash").addEventListener("click", async () => {
  const r = await fetch("/api/open-dashboard", {method: "POST", headers: H, body: "{}"}).catch(() => null);
  $("#dash").textContent = r && r.ok && (await r.json()).ok ? t("ui.dash.opening") : t("ui.dash.failed");
  clearTimeout(dashTimer);
  dashTimer = setTimeout(() => { $("#dash").textContent = t("ui.dash.open"); }, 3000);
});

// The language switch: saved per user (no password). The page changes at once, unsaved changes stay.
function drawLang() {
  document.querySelectorAll("#lang button").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.lang === I18N.pref)));
}
document.querySelectorAll("#lang button").forEach(b => b.addEventListener("click", async () => {
  try {
    const d = await (await fetch("/api/ui/language", {method: "POST", headers: H, body: JSON.stringify({language: b.dataset.lang})})).json();
    if (!d.ok) return;
    setI18n(d.i18n); applyStatic(); drawLang(); if (schema) renderKeep(); else if ($("#content .load-error")) loadFailed();
  } catch (e) { /* keep the current language */ }
}));
applyStatic(); drawLang();

// Forge Settings closes itself after a while without this page (for example while the PC slept). Say so
// instead of failing quietly, and offer to try again.
async function ping() {
  let ok = false;
  try { ok = (await fetch("/api/ping", {headers: H})).ok; } catch (e) { ok = false; }
  $("#conn").hidden = ok;
  return ok;
}
setInterval(ping, 30000);
window.addEventListener("focus", ping);
document.addEventListener("visibilitychange", () => { if (!document.hidden) ping(); });
$("#reconnect").addEventListener("click", async () => {
  $("#reconnect").disabled = true;
  if (!await ping()) $("#conn-text").textContent = t("ui.conn.gone");
  $("#reconnect").disabled = false;
});

window.addEventListener("beforeunload", e => {
  if (schema && changes().length || A.schema.sections.some(s => lookDirty(s.id))) e.preventDefault();
});

// Loading: placeholder cards first, then the page; if the settings can't be read, say so with a way to retry.
function loadFailed() {
  $("#bar").hidden = true;
  const retry = el("button", {type: "button", class: "btn primary", text: t("ui.retry")});
  retry.addEventListener("click", () => {
    $("#content").replaceChildren(el("div", {"aria-hidden": "true"}, [el("div", {class: "skel h"}), el("div", {class: "skel p"}),
                                                                       el("div", {class: "skel card"}), el("div", {class: "skel card"})]));
    start();
  });
  $("#content").replaceChildren(el("section", {class: "card load-error", role: "alert"}, [
    el("h3", {text: t("ui.load.failed")}), el("p", {text: t("ui.load.failed_help")}), retry]));
}
async function start() {
  announce(t("ui.loading"));
  try { await Promise.all([load(), loadLook()]); }
  catch (e) { schema = null; return loadFailed(); }
  go();
}
start();
</script>
<!--__PREVIEW_HOOKS__-->
</body>
</html>
