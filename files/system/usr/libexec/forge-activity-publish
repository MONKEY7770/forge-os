#!/usr/bin/env python3
"""forge-activity-publish: share a short summary of your own Forge activity with Forge Core.

Runs as you (from forge-mode after a mode switch, and from forge-health). Forge Core runs as
its own user and can't read your home folder, so this copies only:
  - mode changes   from ~/.local/state/forge/activity.log
  - problems       from ~/.local/state/forge/health.log (PROBLEM lines)
  - backup result  from ~/.local/state/forge-backup/status.json, if it exists
into /var/lib/forge-activity/<your uid>.jsonl (the newest 200 entries, readable by Forge Core
and other administrators). That folder only lets administrators (wheel) write, and only you
can replace your own file. If you can't write there, this quietly does nothing.
"""
import contextlib
import datetime
import json
import math
import os
import re
import stat
import sys

STATE = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local/state")
OUT_DIR = os.environ.get("FORGE_ACTIVITY_DIR", "/var/lib/forge-activity")
MAX_ENTRIES = 200
TEXT_MAX = 300
READ_MAX = 128 * 1024
_CONTROL = re.compile(r"[\x00-\x1f\x7f-\x9f\u200b-\u200f\u202a-\u202e\u2066-\u2069\ufeff]")
MODE_LINE = re.compile(r"(\S+) mode=([a-z]{1,20})")
PROBLEM_LINE = re.compile(r"(\S+) PROBLEM (.*)")


sys.path.insert(0, os.environ.get("FORGE_LIB", "/usr/lib/forge"))
try:
    from forgecore.policy import clean_details
except Exception:   # Forge Core's helpers missing: share no free text rather than risk a secret
    clean_details = None


def text(value):
    """Printable, secrets hidden first (Forge Core's own helper), then cut. A cut before hiding
    could leave part of a secret that no longer looks like one."""
    value = _CONTROL.sub(" ", str(value)[:READ_MAX])
    if clean_details is None:
        return ""
    return clean_details(value, len(value))[:TEXT_MAX]


def read_own(path, max_bytes=READ_MAX):
    """The end of one of your own regular files, never through a link. "" if not there."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return ""
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
            return ""
        f.seek(max(0, st.st_size - max_bytes))
        data = f.read(max_bytes).decode("utf-8", "replace")
    return data.partition("\n")[2] if st.st_size > max_bytes else data


def when(stamp):
    try:
        ts = datetime.datetime.fromisoformat(stamp).timestamp()
    except (ValueError, OverflowError, OSError):
        return None
    return ts if 0 < ts < 1e10 else None


def number_time(value):
    if isinstance(value, bool):
        return None
    if isinstance(value, (int, float)) and math.isfinite(value) and 0 < value < 1e10:
        return float(value)
    if isinstance(value, str):
        return when(value)
    return None


def backup_entry():
    """forge-backup's status file (fields: result, message, last_run; see its NOTES)."""
    raw = read_own(os.path.join(STATE, "forge-backup/status.json"), 64 * 1024)
    if not raw:
        return None
    try:
        status = json.loads(raw)
    except (ValueError, RecursionError):
        return None
    if not isinstance(status, dict):
        return None
    ts = None
    for k in ("finished", "ts", "time", "last_run", "when"):
        ts = number_time(status.get(k))
        if ts:
            break
    if not ts:
        return None
    ok = status.get("ok")
    if not isinstance(ok, bool):
        result = str(status.get("result", status.get("status", ""))).lower()
        ok = (True if result in ("ok", "ok_with_warnings", "success", "done") else
              False if result in ("failed", "error", "drive_missing", "drive_full", "wrong_password",
                                  "not_set_up") else None)
    msg = next((status[k] for k in ("message", "summary", "error") if isinstance(status.get(k), str)), "")
    return {"ts": ts, "kind": "backup", "ok": ok, "text": text(msg)}


def collect():
    entries = []
    for line in read_own(os.path.join(STATE, "forge/activity.log")).splitlines():
        m = MODE_LINE.fullmatch(line.strip())
        ts = when(m.group(1)) if m else None
        if ts:
            entries.append({"ts": ts, "kind": "mode", "mode": m.group(2)})
    for line in read_own(os.path.join(STATE, "forge/health.log")).splitlines():
        m = PROBLEM_LINE.fullmatch(line.strip())
        ts = when(m.group(1)) if m else None
        if ts:
            entries.append({"ts": ts, "kind": "health", "text": text(m.group(2))})
    b = backup_entry()
    if b:
        entries.append(b)
    entries.sort(key=lambda e: e["ts"])
    return entries[-MAX_ENTRIES:]


def publish(entries):
    uid = os.geteuid()
    try:
        dfd = os.open(OUT_DIR, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    except OSError:
        return   # no folder (or a link): nothing to share with
    try:
        final = f"{uid}.jsonl"
        body = "".join(json.dumps(e, sort_keys=True) + "\n" for e in entries)
        # Skip the write when nothing changed (this runs every few minutes).
        with contextlib.suppress(OSError):
            fd = os.open(final, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
            with os.fdopen(fd, "rb") as f:
                st = os.fstat(f.fileno())
                if (stat.S_ISREG(st.st_mode) and st.st_uid == uid and stat.S_IMODE(st.st_mode) == 0o644
                        and f.read(len(body.encode()) + 1) == body.encode()):
                    return
        # Our own temp files left by a run that was stopped.
        temp = re.compile(rf"\.{uid}\.[0-9a-f]{{12}}\.tmp")
        with contextlib.suppress(OSError):
            for name in os.listdir(dfd):
                if temp.fullmatch(name):
                    with contextlib.suppress(OSError):
                        if os.stat(name, dir_fd=dfd, follow_symlinks=False).st_uid == uid:
                            os.unlink(name, dir_fd=dfd)
        tmp = f".{uid}.{os.urandom(6).hex()}.tmp"
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=dfd)
        except OSError:
            return   # not allowed to write here (not an administrator)
        try:
            with os.fdopen(fd, "w") as f:
                os.fchmod(f.fileno(), 0o644)   # Forge Core reads it through the "other" bit
                f.write(body)
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, final, src_dir_fd=dfd, dst_dir_fd=dfd)
        except OSError:
            with contextlib.suppress(OSError):
                os.unlink(tmp, dir_fd=dfd)
    finally:
        os.close(dfd)


def main():
    publish(collect())
    return 0


if __name__ == "__main__":
    sys.exit(main())
