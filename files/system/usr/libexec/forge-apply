#!/usr/bin/env python3
"""forge-apply: turn Forge OS settings into real system configuration.

Runs as root (through pkexec from the Settings app or forge-config, and
once on first boot). Every file it writes is a small drop-in with "forge" in
its name, so you can always see and remove what it changed.

  forge-apply              apply current settings now
  forge-apply --import F   validate settings file F, save it, then apply
"""
import json
import os
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/lib/forge")
import forgecfg  # noqa: E402

ROOT = os.environ.get("FORGE_ROOT", "")          # for testing only
DRY = os.environ.get("FORGE_DRYRUN") == "1"      # for testing only

DNS = {
    "quad9": "9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net",
    "cloudflare": "1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com",
    "mullvad": "194.242.2.2#dns.mullvad.net",
    "adguard": "94.140.14.14#dns.adguard-dns.com 94.140.15.15#dns.adguard-dns.com",
}
HEADER = "# Written by forge-apply from Forge OS settings. Change it in Settings, not here.\n"
log = []


def path(p):
    return ROOT + p


def write(p, text):
    full = path(p)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, "w") as f:
        f.write(HEADER + text)
    log.append(f"wrote {p}")


def remove(p):
    if os.path.exists(path(p)):
        os.remove(path(p))
        log.append(f"removed {p}")


def run(*cmd):
    if DRY:
        log.append("would run: " + " ".join(cmd))
        return True
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        log.append(f"note: {' '.join(cmd)} failed: {(r.stderr or r.stdout).strip()[:200]}")
    return r.returncode == 0


def service(name, on, user=False):
    scope = ["--global"] if user else ["--now"]
    run("systemctl", "enable" if on else "disable", *scope, name)


def apply(v):
    # Privacy: DNS
    if v["privacy.encrypted_dns"]:
        write("/etc/systemd/resolved.conf.d/90-forge.conf",
              "[Resolve]\n"
              f"DNS={DNS[v['privacy.dns_provider']]}\n"
              f"DNSOverTLS={'yes' if v['privacy.dns_strict'] else 'opportunistic'}\n")
    else:
        remove("/etc/systemd/resolved.conf.d/90-forge.conf")

    # Privacy: NetworkManager
    write("/etc/NetworkManager/conf.d/90-forge.conf",
          "[connectivity]\n"
          f"enabled={'true' if v['privacy.connectivity_check'] else 'false'}\n\n"
          "[device]\n"
          f"wifi.scan-rand-mac-address={'yes' if v['privacy.random_wifi_mac'] else 'no'}\n")

    # Network: Tailscale and firewall
    service("tailscaled.service", v["network.tailscale"])
    action = "--add-interface=tailscale0" if v["network.trust_tailscale"] else "--remove-interface=tailscale0"
    run("firewall-cmd", "--permanent", "--zone=trusted", action)
    run("firewall-cmd", "--reload")

    # AI: Ollama
    host = "0.0.0.0:11434" if v["ai.ollama_remote"] else "127.0.0.1:11434"
    write("/etc/systemd/system/ollama.service.d/90-forge.conf",
          "[Service]\n"
          f"Environment=OLLAMA_HOST={host}\n"
          f"Environment=OLLAMA_KEEP_ALIVE={v['ai.keep_alive_min']}m\n"
          f"Environment=OLLAMA_MAX_LOADED_MODELS={v['ai.max_loaded_models']}\n"
          f"Environment=OLLAMA_MODELS={v['ai.models_dir']}\n"
          f"ReadWritePaths={v['ai.models_dir']}\n")
    if not DRY:
        os.makedirs(path(v["ai.models_dir"]), exist_ok=True)
        run("chown", "-R", "ollama:ollama", path(v["ai.models_dir"]))

    # Agents: resource limits
    write("/etc/systemd/system/agents.slice.d/90-forge.conf",
          "[Slice]\n"
          f"CPUWeight={v['agents.cpu_weight']}\n"
          f"MemoryHigh={v['agents.memory_high_gb']}G\n"
          f"MemoryMax={v['agents.memory_max_gb']}G\n")

    # Monitoring
    write("/etc/systemd/user/forge-health.timer.d/90-forge.conf",
          "[Timer]\nOnUnitActiveSec=\n"
          f"OnUnitActiveSec={v['monitor.interval_min']}min\n")
    service("forge-health.timer", v["monitor.health"], user=True)
    service("smartd.service", v["monitor.smart"])

    # Apps: default Flatpaks (not sure of the exact command name on every BlueBuild version)
    if shutil.which("bluebuild-flatpak-manager"):
        run("bluebuild-flatpak-manager", "enable" if v["apps.auto_reinstall"] else "disable", "all")

    run("systemctl", "daemon-reload")
    run("systemctl", "try-reload-or-restart", "systemd-resolved.service")
    run("systemctl", "try-reload-or-restart", "NetworkManager.service")
    service("ollama.service", v["ai.ollama"])
    if v["ai.ollama"]:
        run("systemctl", "restart", "ollama.service")


def main():
    args = sys.argv[1:]
    schema = forgecfg.load_schema()

    if "--import" in args:
        src = args[args.index("--import") + 1]
        with open(src) as f:
            incoming = json.load(f)
        merged = forgecfg.values(schema, incoming)
        clean, errors = forgecfg.validate(merged, schema)
        if errors:
            print("Not saved:\n" + "\n".join(errors), file=sys.stderr)
            return 2
        conf = forgecfg.OVERRIDES_PATH
        os.makedirs(os.path.dirname(conf), exist_ok=True)
        if os.path.exists(conf):
            shutil.copy2(conf, conf + ".bak")   # one-step undo
        with open(conf, "w") as f:
            json.dump(forgecfg.to_overrides(clean, schema), f, indent=2, sort_keys=True)
        log.append(f"saved {forgecfg.OVERRIDES_PATH}")

    clean, errors = forgecfg.validate(forgecfg.values(schema), schema)
    if errors:
        # Hand-edited file is broken: keep the system working on defaults.
        print("Settings file has problems, using defaults:\n" + "\n".join(errors), file=sys.stderr)
        clean, _ = forgecfg.validate({}, schema)

    apply(clean)
    print("\n".join(log))
    return 0


if __name__ == "__main__":
    sys.exit(main())
