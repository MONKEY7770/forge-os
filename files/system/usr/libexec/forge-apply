#!/usr/bin/env python3
"""forge-apply: turn Forge OS settings into real system configuration.

Runs as root (through pkexec from the Settings app or forge-config, and
once on first boot). Every file it writes is a small drop-in with "forge" in
its name, so you can always see and remove what it changed.

  forge-apply              apply current settings now
  forge-apply --import F   validate settings file F, save it, then apply
  forge-apply --import F --merge   the same, but F only holds the settings to change
  forge-apply --undo [N]   go back to the settings as they were N changes ago (default 1)
  forge-apply --history    show the recent changes: what, from what to what, who, restart needed
  forge-apply --switch-channel stable|testing --confirm
                           switch this PC's update channel (rpm-ostree rebase to the signed image),
                           then save the choice. Without --confirm it only says what it would do.

Every change keeps a snapshot of the settings before it (the newest 10 are kept), in
/var/lib/forge-apply, readable by root only.
"""
import contextlib
import fcntl
import grp
import json
import os
import pwd
import re
import shutil
import select
import signal
import stat
import subprocess
import sys
import time

sys.path.insert(0, "/usr/lib/forge")
import forgecfg  # noqa: E402
import forgerelease  # noqa: E402

ROOT = os.environ.get("FORGE_ROOT", "")          # for testing only
DRY = os.environ.get("FORGE_DRYRUN") == "1"      # for testing only

OLLAMA_USER = "ollama"
# Test seam, only read when FORGE_ROOT is set (so never in real use): run the
# model folder step even in dry mode and give the folder to this user instead.
TEST_OLLAMA_USER = os.environ.get("FORGE_TEST_OLLAMA_USER", "") if ROOT else ""
if TEST_OLLAMA_USER:
    OLLAMA_USER = TEST_OLLAMA_USER
# Test seam, only read when FORGE_ROOT is set (so never in real use): the release steps (update
# channel, automatic rollback) run rpm-ostree, systemctl queries and grub2-editenv from this folder,
# even in dry mode. Without it, dry mode never runs them.
TEST_BIN = os.environ.get("FORGE_TEST_BIN", "") if ROOT else ""

LOCK_WAIT_S = 120             # give up if another apply holds the lock this long
IMPORT_MAX = 1024 * 1024      # largest settings file --import will read
CORE_DIR = "/run/forge-core"  # the only folder Forge Core may import from
MOUNTINFO = "/proc/self/mountinfo"
STATE_DIR = "/var/lib/forge-apply"   # snapshots and change history, root only
KEEP_SNAPSHOTS = 10
HISTORY_MAX = 500                    # lines kept in history.jsonl
# Public, values-free list of changes for the activity timeline (Forge Core reads it).
PUBLIC_DIR = "/var/lib/forge-timeline"
PUBLIC_FILE = "settings.jsonl"
PUBLIC_MAX_LINES = 200
PUBLIC_MAX_BYTES = 64 * 1024

DNS = {
    "quad9": "9.9.9.9#dns.quad9.net 149.112.112.112#dns.quad9.net",
    "cloudflare": "1.1.1.1#cloudflare-dns.com 1.0.0.1#cloudflare-dns.com",
    "mullvad": "194.242.2.2#dns.mullvad.net",
    "adguard": "94.140.14.14#dns.adguard-dns.com 94.140.15.15#dns.adguard-dns.com",
}
HEADER = "# Written by forge-apply from Forge OS settings. Change it in Settings, not here.\n"
log = []


def path(p):
    return ROOT + p


def write(p, text):
    # Last line of defence: generated files never get injected lines.
    if any(ord(c) < 32 and c != "\n" for c in text) or "\x7f" in text:
        raise SystemExit(f"Refusing to write {p}: unexpected control characters")
    full = path(p)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    with open(full, "w") as f:
        f.write(HEADER + text)
        # System config that services and users read. Also repairs files an older version
        # created owner-only.
        os.fchmod(f.fileno(), 0o644)
    log.append(f"wrote {p}")


def write_if_changed(p, text):
    """Like write(), but returns False and does nothing if the file already matches."""
    try:
        with open(path(p)) as f:
            if f.read() == HEADER + text:
                os.fchmod(f.fileno(), 0o644)   # same repair as write(), even when nothing changed
                return False
    except OSError:
        pass
    write(p, text)
    return True


def remove(p):
    if os.path.exists(path(p)):
        os.remove(path(p))
        log.append(f"removed {p}")


def run(*cmd):
    if DRY:
        log.append("would run: " + " ".join(cmd))
        return True
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        log.append(f"note: {' '.join(cmd)} failed: {(r.stderr or r.stdout).strip()[:200]}")
    return r.returncode == 0


# Ollama's port is for Tailscale only ("Allow my other devices to use Ollama"). Bazzite's default
# zone accepts every port above 1024, so each zone rejects it from anything that is not Tailscale
# (100.64.0.0/10, fd7a:115c:a1e0::/48). Harmless while Ollama only listens on 127.0.0.1.
OLLAMA_PORT_RULES = (
    'rule family="ipv4" source NOT address="100.64.0.0/10" port port="11434" protocol="tcp" reject',
    'rule family="ipv6" source NOT address="fd7a:115c:a1e0::/48" port port="11434" protocol="tcp" reject',
)


def firewall_zones():
    """The firewall's zones (all of them: a network connection can be put in any)."""
    if DRY:
        return os.environ.get("FORGE_TEST_ZONES", "FedoraWorkstation trusted").split()
    try:
        r = subprocess.run(["firewall-cmd", "--permanent", "--get-zones"], capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        r = None
    if r is None or r.returncode != 0:
        log.append("note: could not list the firewall zones, so Ollama's port rule was not checked")
        return []
    return [z for z in r.stdout.split() if re.fullmatch(r"[A-Za-z0-9_+-]{1,64}", z)]


def service(name, on, user=False):
    scope = ["--global"] if user else ["--now"]
    run("systemctl", "enable" if on else "disable", *scope, name)


def replace_file(p, text):
    """Replace file p with text in one step. The new file gets p's mode, owner and SELinux label.
    The temporary file has a random name and is created fresh (never a link someone left there).
    A backup of the old file is kept as p.forge.bak."""
    st = os.stat(p)
    # The backup holds the same secrets-adjacent lines as the original: owner-only from the start.
    bak = p + ".forge.bak"
    with open(p, "rb") as src:
        fd = os.open(bak, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
        with os.fdopen(fd, "wb") as dst:
            os.fchmod(dst.fileno(), 0o600)
            shutil.copyfileobj(src, dst)
    folder, base = os.path.split(p)
    for _ in range(20):
        tmp = os.path.join(folder, f".{base}.forge-{os.urandom(6).hex()}")
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
            break
        except FileExistsError:
            continue
    else:
        raise OSError(17, "could not create a temporary file")
    try:
        with os.fdopen(fd, "w", encoding="utf-8", errors="surrogateescape") as f:
            f.write(text)
            f.flush()
            os.fchown(f.fileno(), st.st_uid, st.st_gid)
            os.fchmod(f.fileno(), stat.S_IMODE(st.st_mode))
            with contextlib.suppress(OSError):
                os.setxattr(f.fileno(), "security.selinux", os.getxattr(p, "security.selinux"))
            os.fsync(f.fileno())
        os.replace(tmp, p)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


SHARED_DRIVE_RULE = "/etc/polkit-1/rules.d/90-forge-shared-drive.rules"


def shared_drive_polkit(v):
    """Let administrators open the shared drive without a password, like a USB stick.

    udisks asks for the admin password before mounting a partition on an internal disk, and
    there is no one to type it when this runs at login. The rule only allows mounting, only
    exFAT or NTFS, and only a drive with the name from Settings. Polkit rules are JavaScript,
    so this file has // comments instead of the usual # header."""
    label = v["storage.shared_drive_label"]
    if not v["storage.shared_drive_enabled"] or not re.fullmatch(r"[A-Za-z0-9_-]{1,32}", label):
        remove(SHARED_DRIVE_RULE)
        return
    # The drive name is compared without case, but only when it is plain ASCII: toUpperCase
    # turns some lookalikes (like the long s) into ASCII letters.
    text = ("// Written by forge-apply from Forge OS settings (Storage and shared drive).\n"
            "// Change it in Settings, not here. Lets administrators open the shared drive\n"
            "// without a password: mounting only, exFAT or NTFS only, this drive name only.\n"
            "polkit.addRule(function (action, subject) {\n"
            "    var label = String(action.lookup(\"id.label\") || \"\");\n"
            "    if ((action.id == \"org.freedesktop.udisks2.filesystem-mount-system\" ||\n"
            "         action.id == \"org.freedesktop.udisks2.filesystem-mount\") &&\n"
            "        subject.isInGroup(\"wheel\") &&\n"
            "        [\"exfat\", \"ntfs\"].indexOf(action.lookup(\"id.type\")) >= 0 &&\n"
            "        /^[A-Za-z0-9_-]+$/.test(label) &&\n"
            f"        label.toUpperCase() == {json.dumps(label.upper())}) {{\n"
            "        return polkit.Result.YES;\n"
            "    }\n"
            "});\n")
    if any(ord(c) < 32 and c != "\n" for c in text) or "\x7f" in text:
        raise SystemExit(f"Refusing to write {SHARED_DRIVE_RULE}: unexpected control characters")
    full = path(SHARED_DRIVE_RULE)
    os.makedirs(os.path.dirname(full), exist_ok=True)
    # Fresh temporary file (never a link someone left there), then one atomic swap.
    tmp = f"{full}.forge-{os.urandom(6).hex()}"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    try:
        with os.fdopen(fd, "w") as f:
            f.write(text)
            os.fchmod(f.fileno(), 0o644)
        os.replace(tmp, full)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise
    log.append(f"wrote {SHARED_DRIVE_RULE}")


def usb_crypttab(v):
    """Point encrypted volumes at the USB key file, or back to password only.

    Only touches lines whose key field is "none" or our own forge_key entry,
    so any key setup you made by hand is left alone.
    """
    p = path("/etc/crypttab")
    if not os.path.exists(p):
        log.append("note: no /etc/crypttab (disk not encrypted), USB unlock skipped")
        return
    # Kept byte for byte: a comment in another encoding must not stop the apply.
    # Split only where systemd does (\n), never at the other breaks Python knows (U+2028 and more).
    with open(p, encoding="utf-8", errors="surrogateescape", newline="") as f:
        lines = f.read().split("\n")
    if lines and lines[-1] == "":
        lines.pop()
    ours = f"/forge_key:LABEL={v['security.usb_key_label']}"
    out, changed = [], False
    for line in lines:
        parts = [x for x in re.split(r"[ \t\r]+", line) if x]   # fields as systemd splits them
        if len(parts) < 2 or parts[0].startswith("#"):
            out.append(line)
            continue
        while len(parts) < 4:
            parts.append("none" if len(parts) == 2 else "")
        key = parts[2]
        if key != "none" and not key.startswith("/forge_key:"):
            out.append(line)
            continue
        if not v["security.usb_unlock"] and key == "none" and "keyfile-timeout=" not in line:
            out.append(line)   # already password only
            continue
        opts = [o for o in parts[3].split(",") if o and not o.startswith("keyfile-timeout=")]
        if v["security.usb_unlock"]:
            key = ours
            opts.append(f"keyfile-timeout={v['security.usb_key_timeout_sec']}s")
        else:
            key = "none"
        extra = parts[4:]   # anything after the options is kept as it was
        new = " ".join([parts[0], parts[1], key] + ([",".join(opts)] if opts or extra else []) + extra)
        changed |= new != line
        out.append(new)
    if not changed:
        return
    try:
        replace_file(p, "\n".join(out) + "\n")
    except OSError as e:
        log.append(f"note: could not write /etc/crypttab ({e.strerror}); it was left unchanged, "
                   "USB unlock settings not applied to it")
        return
    log.append("wrote /etc/crypttab (backup: /etc/crypttab.forge.bak)")
    # The disk is unlocked before the system starts, so the boot image needs this file too.
    # --force-sync: without it rpm-ostree says "No changes." when the file is already tracked,
    # and the edited file would only reach the boot image at the next update.
    run("rpm-ostree", "initramfs-etc", "--track=/etc/crypttab", "--force-sync")


def open_dir_nofollow(real):
    """Open a folder one step at a time from /, failing if any step is a link."""
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for part in real.split("/"):
            if part:
                nfd = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                              dir_fd=fd)
                os.close(fd)
                fd = nfd
    except BaseException:
        os.close(fd)
        raise
    return fd


def _unescape_mount(text):
    # The kernel writes space, tab, newline and backslash in mount points as \040 \011 \012 \134.
    return re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), text)


def on_fuse(p):
    """True if path p (as written, no lookups) is inside a FUSE mount, by the mount table.
    Every enclosing mount counts: a normal mount inside a FUSE mount still sits under FUSE."""
    try:
        with open(MOUNTINFO) as f:
            for line in f:
                left, _, right = line.partition(" - ")
                fields = left.split()
                if len(fields) < 5 or not right:
                    continue
                mnt = _unescape_mount(fields[4])
                fstype = right.split()[0]
                if (p == mnt or p.startswith(mnt.rstrip("/") + "/")) and (
                        fstype == "fuse" or fstype.startswith(("fuse.", "fuseblk"))):
                    return True
    except OSError:
        return False
    return False


def resolve_without_fuse(p):
    """Like os.path.realpath(p), but checks the mount table before looking at each step, so a
    link into a FUSE mount is found without touching the FUSE mount. Returns None if any step
    is (or leads) inside FUSE, or if there are too many links."""
    parts = [x for x in p.split("/") if x]
    done = "/"
    links = 0
    while parts:
        part = parts.pop(0)
        if part == ".":
            continue
        if part == "..":
            done = os.path.dirname(done.rstrip("/")) or "/"
            continue
        nxt = os.path.join(done, part)
        if on_fuse(nxt):
            return None
        if os.path.islink(nxt):
            links += 1
            if links > 40:
                return None
            target = os.readlink(nxt)
            if target.startswith("/"):
                done = "/"
            parts = [x for x in target.split("/") if x] + parts
            continue
        done = nxt
    return None if on_fuse(done) else done


MODELS_DIR_TIMEOUT_S = 20


def make_models_dir(d):
    """Run the model folder step in a child process with a time limit, so a stuck mount
    (for example a FUSE mount that never answers) can't hold the settings lock forever."""
    rfd, wfd = os.pipe()
    pid = os.fork()
    if pid == 0:
        code = 0
        try:
            os.close(rfd)
            log.clear()
            make_models_dir_unsafe(d)
        except BaseException as e:   # noqa: BLE001 (report anything, never return into the parent's code)
            log.append(f"note: making {d} failed ({e})")
            code = 1
        finally:
            with contextlib.suppress(OSError):
                os.write(wfd, json.dumps(log).encode())
            os._exit(code)
    os.close(wfd)
    data, deadline = b"", time.monotonic() + MODELS_DIR_TIMEOUT_S
    try:
        while True:
            left = deadline - time.monotonic()
            if left <= 0:
                break
            ready, _, _ = select.select([rfd], [], [], left)
            if not ready:
                break
            chunk = os.read(rfd, 65536)
            if not chunk:
                break
            data += chunk
    finally:
        os.close(rfd)
    if time.monotonic() >= deadline:
        with contextlib.suppress(ProcessLookupError):
            os.kill(pid, signal.SIGKILL)
        os.waitpid(pid, 0)
        log.append(f"note: making {d} did not finish in {MODELS_DIR_TIMEOUT_S} s (a slow or stuck mount?), "
                   "skipped")
        return
    os.waitpid(pid, 0)
    with contextlib.suppress(ValueError):
        log.extend(line for line in json.loads(data or b"[]") if isinstance(line, str))


def make_models_dir_unsafe(d):
    """Create the model folder and give it to the ollama user.

    Works on open folder handles only, never on paths, so a user who owns the
    parent folder cannot swap in a link and make root change another file's
    owner. A folder that already exists is never touched.
    """
    parent, name = os.path.split(path(d))
    shown_parent = os.path.dirname(d)
    try:
        pw = pwd.getpwnam(OLLAMA_USER)
    except KeyError:
        log.append(f"note: no {OLLAMA_USER} user yet, not creating {d}")
        return
    try:
        gid = grp.getgrnam(OLLAMA_USER).gr_gid
    except KeyError:
        gid = pw.pw_gid
    # A user's FUSE mount (sshfs and the like) can make root wait forever while it holds the
    # settings lock. Decide from the mount table, before touching the folder at all.
    if on_fuse(parent):
        log.append(f"note: {shown_parent} is on a FUSE mount, not creating {d} there")
        return
    # With links resolved, the parent must exist and stay inside the allowed places.
    real = resolve_without_fuse(parent)
    if real is None:
        log.append(f"note: {shown_parent} is on a FUSE mount (or has too many links), not creating {d} there")
        return
    base = os.path.realpath(ROOT) if ROOT else ""
    allowed = [base + p for p in forgecfg.MODEL_DIR_PREFIXES]
    if not os.path.isdir(real) or not any(real == p or real.startswith(p + "/") for p in allowed):
        log.append(f"note: {shown_parent} is missing or outside the allowed places, not creating {d}")
        return
    try:
        pfd = open_dir_nofollow(real)
    except OSError as e:
        log.append(f"note: could not open {shown_parent} safely ({e.strerror}), not creating {d}")
        return
    try:
        try:
            os.mkdir(name, 0o755, dir_fd=pfd)
        except FileExistsError:
            log.append(f"note: {d} already exists; not changing its owner, "
                       "make sure the ollama user can write to it")
            return
        try:
            made = os.stat(name, dir_fd=pfd, follow_symlinks=False)
        except OSError as e:
            log.append(f"note: {d} changed right after it was made ({e.strerror}), not changing its owner")
            return
        try:
            fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC, dir_fd=pfd)
        except OSError as e:
            log.append(f"note: {d} changed right after it was made ({e.strerror}), not changing its owner")
            return
        try:
            st = os.fstat(fd)
            # Must still be the empty folder we just made, owned by us (root).
            if (not stat.S_ISDIR(made.st_mode) or (st.st_dev, st.st_ino) != (made.st_dev, made.st_ino)
                    or st.st_uid != os.geteuid() or os.listdir(fd)):
                log.append(f"note: {d} changed right after it was made, not changing its owner")
                return
            os.fchown(fd, pw.pw_uid, gid)
            log.append(f"made {d} for the {OLLAMA_USER} user")
        finally:
            os.close(fd)
    finally:
        os.close(pfd)


REBASE_TIMEOUT_S = 2 * 3600       # the switch downloads a whole system image
GRUBENV = "/boot/grub2/grubenv"
GREENBOOT_UNITS = ("greenboot-healthcheck.service", "greenboot-set-rollback-trigger.service")
# Rollback state greenboot keeps in GRUB's environment block (old and new greenboot-rs names).
GREENBOOT_VARS = ("greenboot_next_deployment_id", "greenboot_rollback_trigger", "boot_counter", "fallback")


def tool(name):
    return os.path.join(TEST_BIN, name) if TEST_BIN else "/usr/bin/" + name


def query(*cmd, timeout=60):
    """Run a read-only system tool for the release steps. Returns (exit code, stdout) or None
    (not run in dry mode, missing, or too slow)."""
    if DRY and not TEST_BIN:
        return None
    try:
        r = subprocess.run([tool(cmd[0]), *cmd[1:]], capture_output=True, text=True, timeout=timeout,
                           stdin=subprocess.DEVNULL, env=dict(os.environ, LC_ALL="C"))
    except (OSError, subprocess.TimeoutExpired):
        return None
    return r.returncode, r.stdout


def ostree_status():
    got = query("rpm-ostree", "status", "--json")
    if not got or got[0] != 0:
        return None
    try:
        return json.loads(got[1])
    except (ValueError, RecursionError):
        return None


def grub_vars():
    got = query("grub2-editenv", GRUBENV, "list")
    if not got or got[0] != 0:
        return {}
    out = {}
    for line in got[1].splitlines():
        k, sep, val = line.partition("=")
        if sep and re.fullmatch(r"[A-Za-z0-9_]{1,64}", k):
            out[k] = val
    return out


def clear_greenboot_vars():
    """Remove greenboot's rollback state from GRUB's environment. /boot can be mounted read-only,
    so like greenboot itself this makes it writable in a private mount namespace only."""
    cmd = [tool("grub2-editenv"), GRUBENV, "unset", *GREENBOOT_VARS]
    if DRY and not TEST_BIN:
        log.append("would run: " + " ".join(cmd))
        return
    if TEST_BIN:
        ok = subprocess.run(cmd, capture_output=True, timeout=60).returncode == 0
    else:
        pid = os.fork()
        if pid == 0:
            code = 1
            try:
                os.unshare(os.CLONE_NEWNS)
                subprocess.run(["/usr/bin/mount", "--make-rprivate", "/"], capture_output=True, timeout=30)
                subprocess.run(["/usr/bin/mount", "-o", "remount,rw", "/boot"], capture_output=True, timeout=30)
                code = subprocess.run(cmd, capture_output=True, timeout=60).returncode
            except BaseException:   # noqa: BLE001 (never return into the parent's code)
                code = 1
            finally:
                os._exit(code)
        _, st = os.waitpid(pid, 0)
        ok = os.waitstatus_to_exitcode(st) == 0
    log.append("cleared the automatic rollback marks from the boot menu settings" if ok else
               "note: could not clear the automatic rollback marks (grub2-editenv failed)")


def auto_rollback(on):
    """greenboot (shipped by Bazzite) checks each start and, on the first start of a new version,
    restarts and finally goes back to the previous version when a required check fails. Forge's
    own check is /usr/libexec/forge-boot-health. Units are never started or stopped here."""
    if on:
        got = query("systemctl", "is-enabled", GREENBOOT_UNITS[0])
        state = got[1].strip() if got else ""
        if state in ("disabled", "masked"):
            # Coming back on: a mark left from while it was off would look like a failed start.
            if any(grub_vars().get(k) for k in GREENBOOT_VARS):
                clear_greenboot_vars()
            if state == "masked":
                run("systemctl", "unmask", *GREENBOOT_UNITS)
        run("systemctl", "enable", *GREENBOOT_UNITS)
        if state in ("disabled", "masked"):
            # So an update waiting for this restart is watched too (it marks the update at shutdown).
            run("systemctl", "start", GREENBOOT_UNITS[1])
    else:
        got = query("systemctl", "is-enabled", GREENBOOT_UNITS[0])
        if got and got[1].strip() not in ("disabled", "masked"):
            # Going off: a countdown left in GRUB would keep counting (Windows starts too) and finally
            # start the other entry every time, with nothing left to stop it.
            if any(grub_vars().get(k) for k in GREENBOOT_VARS):
                clear_greenboot_vars()
        run("systemctl", "disable", *GREENBOOT_UNITS)


def channel_note(chosen):
    """Never switches. Only says so when the saved channel and the image this PC follows differ."""
    f = forgerelease.followed(ostree_status())
    if f is None or f["channel"] == chosen:
        return
    now = f["channel"] or f"another image tag ({f['tag']})"
    log.append(f"Update channel: you chose {chosen}, but this PC follows {now}. Nothing was switched. "
               f"To switch, confirm it in Forge Settings (System, Updates and recovery) or run: "
               f"sudo /usr/libexec/forge-apply --switch-channel {chosen} --confirm")


def switch_channel(channel):
    """rpm-ostree rebase to the signed image of this PC's own Forge image on that channel.
    Returns (ok, message). Signatures are always checked: the target is never unverified."""
    data = ostree_status()
    if data is None and DRY and not TEST_BIN:
        return True, f"would switch to the {channel} channel (dry run)"
    if data is None:
        return False, "could not read the system status (rpm-ostree status). Nothing was changed."
    try:
        target, f = forgerelease.switch_plan(data, channel)
    except ValueError as e:
        return False, f"{e}. Nothing was changed."
    if target is None:
        return True, f"This PC already follows the {channel} channel (signed). Nothing to download."
    try:
        r = subprocess.run([tool("rpm-ostree"), "rebase", target], capture_output=True, text=True,
                           timeout=REBASE_TIMEOUT_S, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired) as e:
        return False, f"rpm-ostree could not switch ({e.__class__.__name__}). Nothing was changed."
    if r.returncode != 0:
        detail = "".join(c if c.isprintable() else " " for c in (r.stderr or r.stdout).strip()[-300:])
        return False, f"rpm-ostree could not switch: {detail}"
    image = target.split("docker://", 1)[1]
    return True, (f"Switched to the {channel} channel: downloaded {image} and checked its signature. "
                  f"The PC starts it after the next restart, and later updates come from the {channel} channel. "
                  + forgerelease.go_back_text(channel))


def take_switch_args(args):
    """Pull --switch-channel NAME and --confirm out of args. Returns (channel, confirm, rest, error)."""
    if "--switch-channel" not in args:
        return None, False, args, None
    i = args.index("--switch-channel")
    channel = args[i + 1] if i + 1 < len(args) else ""
    if channel not in forgerelease.CHANNEL_TAGS:
        return None, False, args, "Not changed: say which channel, for example: --switch-channel testing --confirm"
    rest = args[:i] + args[i + 2:]
    confirm = "--confirm" in rest
    rest = [a for a in rest if a != "--confirm"]
    if "--switch-channel" in rest or rest[:1] == ["--undo"] or (rest and "--import" not in rest):
        return None, False, args, "Not changed: --switch-channel goes alone or with --import FILE."
    return channel, confirm, rest, None


def apply(v):
    # Privacy: DNS
    if v["privacy.encrypted_dns"]:
        write("/etc/systemd/resolved.conf.d/90-forge.conf",
              "[Resolve]\n"
              f"DNS={DNS[v['privacy.dns_provider']]}\n"
              f"DNSOverTLS={'yes' if v['privacy.dns_strict'] else 'opportunistic'}\n")
    else:
        remove("/etc/systemd/resolved.conf.d/90-forge.conf")

    # Privacy: NetworkManager
    write("/etc/NetworkManager/conf.d/90-forge.conf",
          "[connectivity]\n"
          f"enabled={'true' if v['privacy.connectivity_check'] else 'false'}\n\n"
          "[device]\n"
          f"wifi.scan-rand-mac-address={'yes' if v['privacy.random_wifi_mac'] else 'no'}\n")

    # Network: Tailscale and firewall
    service("tailscaled.service", v["network.tailscale"])
    action = "--add-interface=tailscale0" if v["network.trust_tailscale"] else "--remove-interface=tailscale0"
    run("firewall-cmd", "--permanent", "--zone=trusted", action)
    for zone in firewall_zones():
        if zone != "trusted":
            for rule in OLLAMA_PORT_RULES:
                run("firewall-cmd", "--permanent", f"--zone={zone}", f"--add-rich-rule={rule}")
    run("firewall-cmd", "--reload")

    # AI: Ollama
    host = "0.0.0.0:11434" if v["ai.ollama_remote"] else "127.0.0.1:11434"
    # RequiresMountsFor: with the models on another drive, Ollama waits for that drive (and does not
    # start without it) instead of putting new models on the system disk under the empty mount point.
    write("/etc/systemd/system/ollama.service.d/90-forge.conf",
          "[Unit]\n"
          f"RequiresMountsFor={v['ai.models_dir']}\n\n"
          "[Service]\n"
          f"Environment=OLLAMA_HOST={host}\n"
          f"Environment=OLLAMA_KEEP_ALIVE={v['ai.keep_alive_min']}m\n"
          f"Environment=OLLAMA_MAX_LOADED_MODELS={v['ai.max_loaded_models']}\n"
          f"Environment=OLLAMA_MODELS={v['ai.models_dir']}\n"
          f"ReadWritePaths=-{v['ai.models_dir']}\n")
    if not DRY or TEST_OLLAMA_USER:
        make_models_dir(v["ai.models_dir"])

    # Agents: resource limits
    write("/etc/systemd/system/agents.slice.d/90-forge.conf",
          "[Slice]\n"
          f"CPUWeight={v['agents.cpu_weight']}\n"
          f"MemoryHigh={v['agents.memory_high_pct']}%\n"
          f"MemoryMax={v['agents.memory_max_pct']}%\n")

    # Virtual machines: resource limits (libvirt runs VMs in machine.slice)
    write("/etc/systemd/system/machine.slice.d/90-forge.conf",
          "[Slice]\n"
          f"CPUWeight={v['virt.cpu_weight']}\n"
          f"MemoryMax={v['virt.memory_max_pct']}%\n")

    # Monitoring
    write("/etc/systemd/user/forge-health.timer.d/90-forge.conf",
          "[Timer]\nOnUnitActiveSec=\n"
          f"OnUnitActiveSec={v['monitor.interval_min']}min\n")
    service("forge-health.timer", v["monitor.health"], user=True)
    # Settings sync between PCs (per user; it never applies anything by itself)
    service("forge-settings-sync.timer", v["sync.enabled"], user=True)
    service("forge-settings-sync.path", v["sync.enabled"], user=True)
    service("smartd.service", v["monitor.smart"])

    # Apps: default Flatpaks (not sure of the exact command name on every BlueBuild version)
    if shutil.which("bluebuild-flatpak-manager"):
        run("bluebuild-flatpak-manager", "enable" if v["apps.auto_reinstall"] else "disable", "all")

    # Devices and location
    service("bluetooth.service", v["devices.bluetooth"])
    service("cups.socket", v["devices.printing"])
    service("ModemManager.service", v["devices.mobile_data"])
    if v["location.services"]:
        run("systemctl", "unmask", "geoclue.service")
    else:
        run("systemctl", "mask", "--now", "geoclue.service")
    if v["location.services"] and v["location.wifi_lookup"]:
        write("/etc/geoclue/conf.d/90-forge.conf",
              "[wifi]\nenable=true\nurl=https://api.beacondb.net/v1/geolocate\n")
    else:
        remove("/etc/geoclue/conf.d/90-forge.conf")
    # KDE's location-based time zone module, default for every user (each user can still change it).
    write("/etc/xdg/kded6rc",
          "[Module-geotimezoned]\n"
          f"autoload={'true' if v['location.services'] and v['location.auto_timezone'] else 'false'}\n")
    run("timedatectl", "set-ntp", "true")   # keep the clock itself synced

    # Security: USB key unlock for the encrypted disk
    usb_crypttab(v)

    # Storage: shared drive with Windows. The tool runs as each user at login and on plug-in.
    service("forge-shared-drive.service", v["storage.shared_drive_enabled"], user=True)
    service("forge-shared-drive.path", v["storage.shared_drive_enabled"], user=True)
    shared_drive_polkit(v)

    # Updates: automatic rollback (greenboot) and the update channel (only a note, never a switch)
    auto_rollback(v["updates.auto_rollback"])
    channel_note(v["updates.channel"])

    run("systemctl", "daemon-reload")
    # Virtual machines on or off. forge-virt may download virt-manager, so don't wait for it.
    run("systemctl", "--no-block", "start", "forge-virt.service")
    run("systemctl", "try-reload-or-restart", "systemd-resolved.service")
    run("systemctl", "try-reload-or-restart", "NetworkManager.service")
    # Gaming mode's "Wait" choice stops Ollama during a game: keep it stopped until the game ends
    # (forge-mode-apply starts it then); only its "on at boot" state follows the setting now.
    if v["ai.ollama"] and os.path.lexists(ROOT + "/run/forge/gaming/ollama-paused"):
        run("systemctl", "enable", "ollama.service")
    else:
        service("ollama.service", v["ai.ollama"])
        if v["ai.ollama"]:
            run("systemctl", "restart", "ollama.service")

    # Forge Core API (last, because this may be running inside Forge Core itself)
    core_conf = ("[Service]\n"
                 f"Environment=FORGE_CORE_PORT={v['core.port']}\n"
                 f"Environment=FORGE_CORE_INTERVAL={v['core.metrics_interval_s']}\n"
                 f"Environment=FORGE_AGENTS_SCHEDULER={'1' if v['agents.scheduler'] else '0'}\n"
                 f"Environment=FORGE_AGENTS_MAX_PARALLEL={v['agents.max_parallel']}\n")
    core_changed = write_if_changed("/etc/systemd/system/forge-core.service.d/90-forge.conf", core_conf)
    run("systemctl", "daemon-reload")
    later = ["systemd-run", "--no-block", "--on-active=2", f"--unit=forge-core-{time.time_ns()}",
             "--timer-property=RemainAfterElapse=no", "systemctl"]
    if not v["core.enabled"]:
        run(*later, "disable", "--now", "forge-core.service")
    elif core_changed:
        run("systemctl", "enable", "forge-core.service")
        run(*later, "restart", "forge-core.service")
    else:
        run("systemctl", "enable", "--now", "forge-core.service")


def take_lock():
    """One apply at a time, but never wait forever for a stuck one."""
    os.makedirs(path("/run"), exist_ok=True)
    # Owner-only: anyone who can open the lock file could hold it and block every apply.
    fd = os.open(path("/run/forge-apply.lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    os.fchmod(fd, 0o600)
    lock = os.fdopen(fd, "r+")
    deadline = time.monotonic() + LOCK_WAIT_S
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return lock
        except BlockingIOError:
            if time.monotonic() >= deadline:
                lock.close()
                return None
            time.sleep(0.5)


def read_import(src):
    """Read the file given to --import. Returns (bytes, None) or (None, error).

    Never follows a link, never blocks on a special file, and reads at most
    IMPORT_MAX bytes.
    """
    flags = os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC
    dfd = None
    try:
        if os.environ.get("SUDO_USER") == "forge":
            # Forge Core may only hand over a plain file name in its own private folder.
            name = os.path.basename(src)
            if os.path.dirname(src) != CORE_DIR or not name or name.startswith("."):
                return None, "Forge Core may only import from /run/forge-core"
            dfd = os.open(path(CORE_DIR), os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
            fd = os.open(name, flags, dir_fd=dfd)
        else:
            fd = os.open(src, flags)
    except OSError as e:
        return None, f"cannot open {src} safely ({e.strerror})"
    finally:
        if dfd is not None:
            os.close(dfd)
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            return None, f"{src} is not a regular file"
        chunks, size = [], 0
        while size <= IMPORT_MAX:
            chunk = os.read(fd, IMPORT_MAX + 1 - size)
            if not chunk:
                break
            chunks.append(chunk)
            size += len(chunk)
        if size > IMPORT_MAX:
            return None, f"{src} is larger than 1 MB"
        return b"".join(chunks), None
    finally:
        os.close(fd)


def state_dir(*parts):
    d = path(STATE_DIR)
    for sub in ("", "snapshots"):
        full = os.path.join(d, sub) if sub else d
        os.makedirs(full, exist_ok=True)
        os.chmod(full, 0o700)
    return os.path.join(d, *parts)


SNAP_NAME = re.compile(r"^[0-9]{10}\.json$")


def snapshots():
    """Snapshot files, newest first. Ordered by a counter, not the clock: a clock that jumps
    back (a wrong clock at boot, corrected later) must not change which one undo picks."""
    d = state_dir("snapshots")
    return [os.path.join(d, f) for f in sorted((f for f in os.listdir(d) if SNAP_NAME.match(f)), reverse=True)]


def next_seq():
    p = state_dir("seq")
    try:
        with open(p) as f:
            n = int(f.read().strip() or "0")
    except (OSError, ValueError):
        n = 0
    names = [int(f[:10]) for f in os.listdir(state_dir("snapshots")) if SNAP_NAME.match(f)]
    n = max([n] + names) + 1
    if n > 9999999999:
        # The counter is full (after ten billion saves): number the kept snapshots from 1 again,
        # keeping their order, so names keep the same width and undo still finds them.
        d = state_dir("snapshots")
        for i, old in enumerate(sorted(names), start=1):
            os.rename(os.path.join(d, f"{old:010d}.json"), os.path.join(d, f"{i:010d}.json"))
        n = len(names) + 1
    fd = os.open(p + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(str(n))
    os.replace(p + ".tmp", p)
    return n


def read_snapshot(p):
    """Read a snapshot like an import: a regular file, no links, no FIFOs, size capped."""
    try:
        fd = os.open(p, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError as e:
        return None, f"could not open that snapshot ({e.strerror})"
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return None, "that snapshot is not a regular file"
        if st.st_size > IMPORT_MAX:
            return None, "that snapshot is too large"
        return os.read(fd, IMPORT_MAX + 1).decode("utf-8", "replace"), None
    finally:
        os.close(fd)


def take_snapshot(values, schema):
    """Written whole and then given its name, so a full disk never leaves a cut-off snapshot."""
    name = f"{next_seq():010d}.json"
    final = state_dir("snapshots", name)
    tmp = state_dir("snapshots", f".snap-{os.urandom(6).hex()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(forgecfg.to_overrides(values, schema), f, indent=2, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        os.link(tmp, final)          # fails if the name exists, unlike replace
    finally:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
    return final


SNAP_TEMP = re.compile(r"\.snap-[0-9a-f]{12}")   # used with fullmatch


def prune_snapshots():
    for old in snapshots()[KEEP_SNAPSHOTS:]:
        with contextlib.suppress(OSError):
            os.unlink(old)
    # Temp files from a save stopped by a power loss (we hold the lock, so none is in use).
    d = state_dir("snapshots")
    for name in os.listdir(d):
        if SNAP_TEMP.fullmatch(name):
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(d, name))


def who():
    if os.environ.get("SUDO_USER") == "forge":
        return "forge (Forge Core)"
    if os.environ.get("SUDO_USER"):
        return os.environ["SUDO_USER"]
    uid = os.environ.get("PKEXEC_UID", "")
    if uid.isdigit():
        try:
            return pwd.getpwuid(int(uid)).pw_name
        except KeyError:
            return f"uid {uid}"
    return "root"


def record(action, before, after, schema):
    """Append one line to the change history and say what needs a restart."""
    def short(v):
        return v[:200] + "..." if isinstance(v, str) and len(v) > 200 else v
    changed = {k: [short(before.get(k)), short(after.get(k))] for k in sorted(after) if before.get(k) != after.get(k)}
    restart = {"boot": [], "login": []}
    for item in schema.get("settings", []):
        kind = item.get("restart")
        if item.get("key") in changed and kind in restart:
            restart[kind].append(item["key"])
    # Said first, so the note isn't lost if the history can't be written.
    if restart["boot"]:
        log.append("Takes effect after a restart of the PC: " + ", ".join(restart["boot"]))
    if restart["login"]:
        log.append("Takes effect after you log out and in again: " + ", ".join(restart["login"]))
    entry = {"ts": time.time(), "by": who(), "action": action, "changed": changed, "restart": restart}
    hist = state_dir("history.jsonl")
    lines = []
    with contextlib.suppress(OSError):
        with open(hist) as f:
            lines = f.read().splitlines()
    lines = (lines + [json.dumps(entry, sort_keys=True)])[-HISTORY_MAX:]
    fd = os.open(hist + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(hist + ".tmp", hist)


def show_history(limit=20):
    try:
        with open(state_dir("history.jsonl")) as f:
            lines = f.read().splitlines()[-limit:]
    except OSError:
        lines = []
    if not lines:
        print("No changes recorded yet.")
        return
    for line in lines:
        try:
            e = json.loads(line)
            out = [f"{time.strftime('%Y-%m-%d %H:%M', time.localtime(e.get('ts', 0)))}  "
                   f"{e.get('action', '?')} by {e.get('by', '?')}"]
            for k, (old, new) in (e.get("changed") or {}).items():
                out.append(f"    {k}: {old!r} -> {new!r}")
            for kind, label in (("boot", "restart the PC"), ("login", "log out and in")):
                if (e.get("restart") or {}).get(kind):
                    out.append(f"    needs: {label}")
        except (ValueError, TypeError, AttributeError, OverflowError, OSError, RecursionError):
            out = ["(an unreadable entry was skipped)"]
        print("\n".join(out))


TEMP_NAME = re.compile(r"\.settings\.forge-[0-9a-f]{12}")   # used with fullmatch
# Test seam, only read when FORGE_ROOT is set (so never in real use): fail the save like a full disk.
TEST_SAVE_FAILS = os.environ.get("FORGE_TEST_SAVE_FAILS") == "1" if ROOT else False


def write_settings(conf, clean, schema):
    """Written to a new file and swapped in, so nothing ever reads a half-written file (a half
    file reads as "all defaults", which could, for example, turn virtual machines off).
    Readable by desktop users, who read their settings from here (no secrets in it)."""
    folder = os.path.dirname(conf)
    os.makedirs(folder, exist_ok=True)
    # Temp files left by a save that was killed (we hold the lock, so none is in use).
    for name in os.listdir(folder):
        if TEMP_NAME.fullmatch(name):
            with contextlib.suppress(OSError):
                os.unlink(os.path.join(folder, name))
    tmp = os.path.join(folder, f".settings.forge-{os.urandom(6).hex()}")
    bak_tmp = os.path.join(folder, f".settings.forge-{os.urandom(6).hex()}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(forgecfg.to_overrides(clean, schema), f, indent=2, sort_keys=True)
            f.flush()
            if TEST_SAVE_FAILS:
                raise OSError(28, "No space left on device")
            os.fsync(f.fileno())
        # The new settings are safely written: only now replace the one-step undo copy
        # (also written whole first), then swap the new settings in.
        try:
            sfd = os.open(conf, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except FileNotFoundError:
            sfd = None
        if sfd is not None:
            with os.fdopen(sfd, "rb") as src:
                dfd = os.open(bak_tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644)
                with os.fdopen(dfd, "wb") as dst:
                    os.fchmod(dst.fileno(), 0o644)   # same as the settings themselves
                    shutil.copyfileobj(src, dst)
            os.replace(bak_tmp, conf + ".bak")
        os.replace(tmp, conf)
    except BaseException:
        for t in (tmp, bak_tmp):
            if os.path.lexists(t):
                os.unlink(t)
        raise
    os.chmod(folder, 0o755)


def save_settings(clean, schema, action):
    """Snapshot the current settings, save the new ones, record the change.
    Returns an error message if the save failed (the old settings then stay as they were)."""
    # As they are in the file, even a bad value, so undo can bring back exactly what was there.
    before = forgecfg.values(schema)
    conf = forgecfg.OVERRIDES_PATH
    snap = None
    try:
        snap = take_snapshot(before, schema)
        write_settings(conf, clean, schema)
    except OSError as e:
        if snap:
            with contextlib.suppress(OSError):
                os.unlink(snap)   # nothing changed, so no undo point for it
        return f"Not saved: writing the settings failed ({e.strerror}). Your settings are unchanged."
    prune_snapshots()
    log.append(f"saved {forgecfg.OVERRIDES_PATH}")
    try:
        record(action, before, clean, schema)
    except OSError as e:
        with contextlib.suppress(OSError):
            os.unlink(state_dir("history.jsonl") + ".tmp")
        log.append(f"note: saved, but the change history could not be written ({e.strerror})")
    try:
        record_public(action, before, clean, schema)
    except (OSError, ValueError) as e:
        log.append(f"note: saved, but the activity timeline could not be written ({getattr(e, 'strerror', None) or e})")
    return None


PUBLIC_TEMP = re.compile(r"\.settings\.jsonl-[0-9a-f]{12}")   # used with fullmatch


def record_public(action, before, after, schema):
    """Add one line to the public timeline file: when, who, which settings and what needs a
    restart. Never the values (they stay in the root-only history). Everyone may read it.
    Written to a new file and swapped in, never through a link, and kept small."""
    keys = sorted(k for k in after if before.get(k) != after.get(k))
    if not keys:
        return
    restart = {"boot": [], "login": []}
    for item in schema.get("settings", []):
        if item.get("key") in keys and item.get("restart") in restart:
            restart[item["restart"]].append(item["key"])
    line = json.dumps({"ts": time.time(), "by": who(), "action": action, "keys": keys, "restart": restart},
                      sort_keys=True)
    folder = path(PUBLIC_DIR)
    os.makedirs(folder, mode=0o755, exist_ok=True)
    dfd = os.open(folder, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        if os.fstat(dfd).st_uid != os.geteuid():
            raise ValueError(f"{PUBLIC_DIR} is not owned by root")
        os.fchmod(dfd, 0o755)
        for name in os.listdir(dfd):
            if PUBLIC_TEMP.fullmatch(name):   # left by a save that was killed (we hold the lock)
                with contextlib.suppress(OSError):
                    os.unlink(name, dir_fd=dfd)
        lines = []
        try:
            fd = os.open(PUBLIC_FILE, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, dir_fd=dfd)
        except OSError:
            fd = None   # missing, or a link: start a new file (the link is replaced, never followed)
        if fd is not None:
            with os.fdopen(fd, "rb") as f:
                st = os.fstat(f.fileno())
                if stat.S_ISREG(st.st_mode):
                    f.seek(max(0, st.st_size - PUBLIC_MAX_BYTES))
                    data = f.read(PUBLIC_MAX_BYTES).decode("utf-8", "replace")
                    lines = data.splitlines()[1:] if st.st_size > PUBLIC_MAX_BYTES else data.splitlines()
                    lines = [x for x in lines if x.strip()]
        lines = (lines + [line])[-PUBLIC_MAX_LINES:]
        while len(lines) > 1 and sum(len(x.encode()) + 1 for x in lines) > PUBLIC_MAX_BYTES:
            lines.pop(0)
        tmp = f".settings.jsonl-{os.urandom(6).hex()}"
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC, 0o644, dir_fd=dfd)
        try:
            with os.fdopen(fd, "w") as f:
                os.fchmod(f.fileno(), 0o644)
                f.write("\n".join(lines) + "\n")
                f.flush()
                os.fsync(f.fileno())
            os.replace(tmp, PUBLIC_FILE, src_dir_fd=dfd, dst_dir_fd=dfd)
        except BaseException:
            with contextlib.suppress(OSError):
                os.unlink(tmp, dir_fd=dfd)
            raise
    finally:
        os.close(dfd)


def load_object(data):
    try:
        obj = json.loads(data)
    except (ValueError, RecursionError):
        return None
    return obj if isinstance(obj, dict) else None


def main():
    # Files written here are system config that services and users must read. Forge Core runs
    # with UMask=0077, and this runs from it too, so set the normal umask. Private files
    # (snapshots, history) set their own owner-only modes.
    os.umask(0o022)
    args = sys.argv[1:]
    schema = forgecfg.load_schema()

    # One apply at a time (Settings app, terminal and API may all call this).
    lock = take_lock()
    if lock is None:
        print(f"Not saved or applied: another forge-apply is still running after {LOCK_WAIT_S} s. "
              "Try again later.", file=sys.stderr)
        return 1

    if os.environ.get("SUDO_USER") == "forge" and (len(args) != 2 or args[0] != "--import"):
        print("Not saved: Forge Core may only run forge-apply --import <file>", file=sys.stderr)
        return 2

    switch, confirm, args, err = take_switch_args(args)
    if err:
        print(err, file=sys.stderr)
        return 2
    if switch and not confirm:
        f = forgerelease.followed(ostree_status())
        where = (forgerelease.target_ref(f["image"], switch).split("docker://", 1)[1] if f else
                 f"the {switch} image of this PC's Forge OS image")
        print(f"Not changed. This would switch this PC to the {switch} channel: download {where}, check its "
              f"signature, and start it after the next restart. To do it, run the same command with --confirm.\n"
              + forgerelease.go_back_text(switch), file=sys.stderr)
        return 2

    if args[:1] == ["--history"]:
        show_history()
        return 0

    if "--import" in args or args[:1] == ["--undo"] or switch:
        merge = False
        if switch and "--import" not in args:
            # Only the channel changes, saved after the switch worked.
            incoming, merge, action, what = {"updates.channel": switch}, True, "switch-channel", "the channel"
        elif args[:1] == ["--undo"]:
            steps = args[1] if len(args) > 1 else "1"
            snaps = snapshots()
            if not re.fullmatch(r"[1-9][0-9]{0,3}", steps):
                print("Not changed: say how many changes to go back, for example: forge-apply --undo 2",
                      file=sys.stderr)
                return 2
            if int(steps) > len(snaps):
                print(f"Not changed: only {len(snaps)} change(s) can be undone.", file=sys.stderr)
                return 2
            data, err = read_snapshot(snaps[int(steps) - 1])
            if err:
                print(f"Not changed: {err}.", file=sys.stderr)
                return 2
            incoming = load_object(data)
            action, what = "undo", "that snapshot"
        else:
            i = args.index("--import")
            if i + 1 >= len(args) or args[i + 1].startswith("--"):
                print("Not saved: say which file to import, for example: forge-apply --import settings.json",
                      file=sys.stderr)
                return 2
            src = args[i + 1]
            merge = "--merge" in args
            data, err = read_import(src)
            if err:
                print("Not saved: " + err, file=sys.stderr)
                return 2
            incoming = load_object(data)
            action, what = "import", "the settings file"
            if incoming is not None and "format" in incoming:
                # An export (forge-config export, or another PC's file): checked like any untrusted file.
                settings, _, _, err = forgecfg.parse_export(data, schema)
                if err:
                    print("Not saved: " + err, file=sys.stderr)
                    return 2
                if not merge:
                    # Shareable settings missing from the file go back to default; this PC's own stay.
                    machine = forgecfg.machine_keys(schema)
                    defaults = {k: s["default"] for k, s in forgecfg.settings_by_key(schema).items()
                                if k not in machine}
                    settings, merge = dict(defaults, **settings), True
                incoming = settings
        if incoming is None:
            print(f"Not saved: {what} must be a JSON object of setting names and values.", file=sys.stderr)
            return 2
        if merge:
            # Only the given settings change; everything else stays exactly as it is in the file now
            # (read under the lock). A bad value already there makes the save fail below instead of
            # being replaced by defaults, and a file that can't be read is never overwritten.
            current = None
            try:
                with open(forgecfg.OVERRIDES_PATH) as f:
                    current = load_object(f.read())
            except FileNotFoundError:
                current = {}
            except (OSError, UnicodeDecodeError):
                pass
            if current is None:
                print(f"Not saved: {forgecfg.OVERRIDES_PATH} can't be read as settings. Fix or remove it first, "
                      "or import a whole settings file.", file=sys.stderr)
                return 2
            incoming = dict(current, **incoming)
        merged = forgecfg.values(schema, incoming)
        clean, errors = forgecfg.validate(merged, schema)
        if errors:
            print("Not saved:\n" + "\n".join(errors), file=sys.stderr)
            return 2
        if switch:
            # The switch comes first: if it fails, nothing is saved.
            if clean["updates.channel"] != switch:
                print(f"Not saved: the settings say {clean['updates.channel']}, not {switch}.", file=sys.stderr)
                return 2
            ok, msg = switch_channel(switch)
            if not ok:
                print("Not saved: " + msg, file=sys.stderr)
                return 1
            log.append(msg)
        err = save_settings(clean, schema, action)
        if err:
            print(err, file=sys.stderr)
            return 1

    clean, errors = forgecfg.validate(forgecfg.values(schema), schema)
    if errors:
        # Hand-edited file is broken: keep the system working on defaults.
        print("Settings file has problems, using defaults:\n" + "\n".join(errors), file=sys.stderr)
        clean, _ = forgecfg.validate({}, schema)

    apply(clean)
    print("\n".join(log))
    return 0


if __name__ == "__main__":
    sys.exit(main())
