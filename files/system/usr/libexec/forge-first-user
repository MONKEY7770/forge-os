#!/usr/bin/bash
# Plasma Setup (the first-boot wizard that creates the first account) runs exactly while there is
# no account for a person, instead of while /etc/plasma-setup-done is missing. So it never runs on a
# PC that already has accounts (one rebased from Bazzite, which never had that file), and it comes
# back if creating the account failed. Used by plasma-setup.service.d/forge.conf.
#   check   exit 0 when there is no account with UID 1000 to 60513 (60001 and up: systemd-homed),
#           else 1, so systemd skips the wizard. Accounts are read with getent (local files,
#           systemd-homed and network accounts alike). If they can't be read, also 1: the wizard
#           lets anyone at the screen create an administrator without a password.
# (Plasma Setup's own temporary user is a system account, below 1000.)
set -uo pipefail

case "${1:-}" in
  check)
    if [ -n "${FORGE_PASSWD:-}" ]; then
      accounts=$(cat -- "$FORGE_PASSWD") || exit 1     # tests
    else
      accounts=$(getent passwd) || exit 1
    fi
    people=$(awk -F: '$3 >= 1000 && $3 <= 60513 { n++ } END { print n + 0 }' <<< "$accounts") || exit 1
    [ "$people" = 0 ] && exit 0
    exit 1
    ;;
  *)
    echo "usage: forge-first-user check" >&2
    exit 2
    ;;
esac
