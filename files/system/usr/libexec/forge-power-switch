#!/usr/bin/env python3
"""forge-power-switch: on a laptop, switch the performance mode when the charger is
plugged in or out. Started by a udev rule; does nothing unless "Laptop: switch mode on
charger" (modes.auto_switch) is on. Applies the same things as forge-mode: the agents'
CPU priority and memory limit, the power profile, and unloading AI models if that mode
says so. Runs as root, so it needs no password prompt.
"""
import os
import re
import subprocess
import sys

sys.path.insert(0, os.environ.get("FORGE_LIB", "/usr/lib/forge"))
import forgecfg  # noqa: E402

SYSFS = os.environ.get("FORGE_SYSFS", "/sys")
STATE = os.environ.get("FORGE_POWER_STATE", "/var/lib/forge-power")
MODES = ("quiet", "agents", "creative", "gaming")
MAX_MODELS = 8   # the most Ollama can have loaded (Forge setting ai.max_loaded_models)
MODEL_NAME = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:/-]{0,200}$")


def read(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return None


def on_charger():
    """True or False on a laptop; None on a desktop (no battery) or if it can't be told."""
    base = os.path.join(SYSFS, "class", "power_supply")
    try:
        supplies = os.listdir(base)
    except OSError:
        return None
    # A wireless mouse or controller is also a "Battery", with scope "Device": not the PC's.
    kinds = {s: read(os.path.join(base, s, "type")) for s in supplies
             if read(os.path.join(base, s, "scope")) != "Device"}
    if "Battery" not in kinds.values():
        return None
    online = [read(os.path.join(base, s, "online")) for s, k in kinds.items() if k == "Mains"]
    if not online:
        return None
    return "1" in online


def run(*cmd, timeout=60):
    try:
        return subprocess.run(list(cmd), capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"note: {cmd[0]} failed ({e})", file=sys.stderr)
        return None


def main():
    vals, errors = forgecfg.validate(forgecfg.values())
    if errors:
        print("Settings have problems, so the mode is not switched:\n  " + "\n  ".join(errors), file=sys.stderr)
        return 0
    if not vals.get("modes.auto_switch"):
        return 0
    ac = on_charger()
    if ac is None:
        return 0
    mode = vals["modes.on_charger" if ac else "modes.on_battery"]
    if mode not in MODES:
        return 0
    want = f"{'charger' if ac else 'battery'}:{mode}"
    last = read(os.path.join(STATE, "last"))
    if last == want:
        return 0

    run("systemctl", "set-property", "--runtime", "agents.slice",
        f"CPUWeight={int(vals[f'modes.{mode}.cpu_weight'])}",
        f"MemoryHigh={int(vals[f'modes.{mode}.memory_high_pct'])}%")
    run("powerprofilesctl", "set", vals[f"modes.{mode}.power"])
    # Only ask Ollama when its own service is running: otherwise anyone could be listening on its port.
    active = run("systemctl", "is-active", "--quiet", "ollama.service")
    if vals.get(f"modes.{mode}.unload_models") and active is not None and active.returncode == 0:
        ps = run("ollama", "ps")
        for line in ((ps.stdout if ps else "") or "").splitlines()[1:1 + MAX_MODELS]:
            name = line.split()[0] if line.split() else ""
            if MODEL_NAME.match(name):
                run("ollama", "stop", name, timeout=15)

    os.makedirs(STATE, exist_ok=True)
    with open(os.path.join(STATE, "last"), "w") as f:
        f.write(want + "\n")
    print(f"On {'the charger' if ac else 'battery'}: switched to {mode} mode.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
