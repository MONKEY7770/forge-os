{
  "groups": [
    {"id": "privacy", "label": "Privacy"},
    {"id": "network", "label": "Network and remote access"},
    {"id": "ai", "label": "AI and local models"},
    {"id": "agents", "label": "Agent resource limits"},
    {"id": "monitor", "label": "Self-monitoring"},
    {"id": "modes", "label": "Performance modes"},
    {"id": "apps", "label": "Apps"}
  ],
  "settings": [
    {"key": "privacy.encrypted_dns", "group": "privacy", "type": "toggle", "default": true,
     "label": "Encrypted DNS", "tags": ["privacy", "network", "dns"],
     "help": "Hides the websites you look up from your internet provider."},
    {"key": "privacy.dns_provider", "group": "privacy", "type": "select", "default": "quad9",
     "options": ["quad9", "cloudflare", "mullvad", "adguard"],
     "label": "DNS provider", "tags": ["privacy", "network", "dns"],
     "help": "Quad9 and Mullvad keep no logs. AdGuard also blocks ads. Cloudflare is the fastest."},
    {"key": "privacy.dns_strict", "group": "privacy", "type": "toggle", "default": false,
     "label": "Strict encrypted DNS", "tags": ["privacy", "dns", "advanced"],
     "help": "Never fall back to unencrypted DNS. Safer, but some networks (hotels, schools) will stop working."},
    {"key": "privacy.connectivity_check", "group": "privacy", "type": "toggle", "default": false,
     "label": "Online check", "tags": ["privacy", "network"],
     "help": "Lets the system ping an outside server to detect Wi-Fi login pages."},
    {"key": "privacy.random_wifi_mac", "group": "privacy", "type": "toggle", "default": true,
     "label": "Random Wi-Fi address while scanning", "tags": ["privacy", "network", "wifi"],
     "help": "Stops nearby Wi-Fi networks from tracking this PC."},

    {"key": "network.tailscale", "group": "network", "type": "toggle", "default": true,
     "label": "Tailscale", "tags": ["remote", "network", "service"],
     "help": "Private network between your phone, laptops and this PC."},
    {"key": "network.trust_tailscale", "group": "network", "type": "toggle", "default": true,
     "label": "Trust my Tailscale devices", "tags": ["remote", "network", "firewall", "security"],
     "help": "Lets your own devices reach Sunshine, RustDesk and Ollama. Everything else stays blocked."},

    {"key": "ai.ollama", "group": "ai", "type": "toggle", "default": true,
     "label": "Ollama (local models)", "tags": ["ai", "service", "performance"],
     "help": "Runs AI models on your GPU."},
    {"key": "ai.ollama_remote", "group": "ai", "type": "toggle", "default": false,
     "label": "Allow my other devices to use Ollama", "tags": ["ai", "remote", "network", "security"],
     "help": "Other devices can reach it through Tailscale only, because the firewall blocks everything else."},
    {"key": "ai.keep_alive_min", "group": "ai", "type": "number", "default": 5, "min": 0, "max": 1440,
     "label": "Unload idle model after (minutes)", "tags": ["ai", "performance", "vram", "gaming"],
     "help": "Lower frees VRAM for games sooner. 0 unloads right away."},
    {"key": "ai.max_loaded_models", "group": "ai", "type": "number", "default": 1, "min": 1, "max": 8,
     "label": "Models loaded at once", "tags": ["ai", "performance", "vram"],
     "help": "With 12 GB VRAM, 1 is safest for big models."},
    {"key": "ai.models_dir", "group": "ai", "type": "text", "default": "/var/lib/ollama/models",
     "label": "Model storage folder", "tags": ["ai", "storage"],
     "help": "Point this at a bigger drive if models fill up your disk."},

    {"key": "agents.cpu_weight", "group": "agents", "type": "number", "default": 50, "min": 1, "max": 10000,
     "label": "Agent CPU priority", "tags": ["agents", "performance", "cpu"],
     "help": "100 is normal. Lower lets games and the desktop win when the CPU is busy."},
    {"key": "agents.memory_high_gb", "group": "agents", "type": "number", "default": 40, "min": 1, "max": 64,
     "label": "Slow agents down above (GB RAM)", "tags": ["agents", "performance", "memory"],
     "help": "Soft limit. Agents slow down instead of crashing."},
    {"key": "agents.memory_max_gb", "group": "agents", "type": "number", "default": 48, "min": 1, "max": 64,
     "label": "Hard memory cap (GB RAM)", "tags": ["agents", "performance", "memory"],
     "help": "Agents can never use more than this."},

    {"key": "monitor.health", "group": "monitor", "type": "toggle", "default": true,
     "label": "Health checks", "tags": ["monitoring", "service"],
     "help": "Checks services, disks, GPU and memory in the background."},
    {"key": "monitor.interval_min", "group": "monitor", "type": "number", "default": 10, "min": 1, "max": 1440,
     "label": "Check every (minutes)", "tags": ["monitoring", "performance"], "help": ""},
    {"key": "monitor.notify", "group": "monitor", "type": "toggle", "default": true,
     "label": "Notify me about problems", "tags": ["monitoring", "notifications"], "help": ""},
    {"key": "monitor.gpu_temp_warn", "group": "monitor", "type": "number", "default": 85, "min": 50, "max": 100,
     "label": "Warn when GPU is above (C)", "tags": ["monitoring", "gpu", "temperature"], "help": ""},
    {"key": "monitor.disk_warn_pct", "group": "monitor", "type": "number", "default": 90, "min": 50, "max": 99,
     "label": "Warn when a disk is fuller than (%)", "tags": ["monitoring", "storage"], "help": ""},
    {"key": "monitor.mem_warn_gb", "group": "monitor", "type": "number", "default": 4, "min": 1, "max": 32,
     "label": "Warn when free RAM is below (GB)", "tags": ["monitoring", "memory"], "help": ""},
    {"key": "monitor.check_ollama", "group": "monitor", "type": "toggle", "default": true,
     "label": "Warn if Ollama stops", "tags": ["monitoring", "ai"], "help": ""},
    {"key": "monitor.smart", "group": "monitor", "type": "toggle", "default": true,
     "label": "Disk health (SMART)", "tags": ["monitoring", "storage", "service"],
     "help": "Warns before a drive fails."},

    {"key": "modes.gaming.cpu_weight", "group": "modes", "type": "number", "default": 20, "min": 1, "max": 10000,
     "label": "Gaming: agent CPU priority", "tags": ["modes", "gaming", "cpu"], "help": ""},
    {"key": "modes.gaming.memory_high_gb", "group": "modes", "type": "number", "default": 16, "min": 1, "max": 64,
     "label": "Gaming: agent RAM soft limit (GB)", "tags": ["modes", "gaming", "memory"], "help": ""},
    {"key": "modes.gaming.power", "group": "modes", "type": "select", "default": "performance",
     "options": ["performance", "balanced", "power-saver"],
     "label": "Gaming: power profile", "tags": ["modes", "gaming", "power"], "help": ""},
    {"key": "modes.gaming.unload_models", "group": "modes", "type": "toggle", "default": true,
     "label": "Gaming: unload AI models", "tags": ["modes", "gaming", "vram", "ai"], "help": ""},

    {"key": "modes.agents.cpu_weight", "group": "modes", "type": "number", "default": 100, "min": 1, "max": 10000,
     "label": "Agents: agent CPU priority", "tags": ["modes", "agents", "cpu"], "help": ""},
    {"key": "modes.agents.memory_high_gb", "group": "modes", "type": "number", "default": 48, "min": 1, "max": 64,
     "label": "Agents: agent RAM soft limit (GB)", "tags": ["modes", "agents", "memory"], "help": ""},
    {"key": "modes.agents.power", "group": "modes", "type": "select", "default": "performance",
     "options": ["performance", "balanced", "power-saver"],
     "label": "Agents: power profile", "tags": ["modes", "agents", "power"], "help": ""},
    {"key": "modes.agents.unload_models", "group": "modes", "type": "toggle", "default": false,
     "label": "Agents: unload AI models", "tags": ["modes", "agents", "ai"], "help": ""},

    {"key": "modes.creative.cpu_weight", "group": "modes", "type": "number", "default": 50, "min": 1, "max": 10000,
     "label": "Creative: agent CPU priority", "tags": ["modes", "creative", "cpu"], "help": ""},
    {"key": "modes.creative.memory_high_gb", "group": "modes", "type": "number", "default": 32, "min": 1, "max": 64,
     "label": "Creative: agent RAM soft limit (GB)", "tags": ["modes", "creative", "memory"], "help": ""},
    {"key": "modes.creative.power", "group": "modes", "type": "select", "default": "performance",
     "options": ["performance", "balanced", "power-saver"],
     "label": "Creative: power profile", "tags": ["modes", "creative", "power"], "help": ""},
    {"key": "modes.creative.unload_models", "group": "modes", "type": "toggle", "default": false,
     "label": "Creative: unload AI models", "tags": ["modes", "creative", "ai"], "help": ""},

    {"key": "modes.quiet.cpu_weight", "group": "modes", "type": "number", "default": 30, "min": 1, "max": 10000,
     "label": "Quiet: agent CPU priority", "tags": ["modes", "quiet", "cpu"], "help": ""},
    {"key": "modes.quiet.memory_high_gb", "group": "modes", "type": "number", "default": 24, "min": 1, "max": 64,
     "label": "Quiet: agent RAM soft limit (GB)", "tags": ["modes", "quiet", "memory"], "help": ""},
    {"key": "modes.quiet.power", "group": "modes", "type": "select", "default": "power-saver",
     "options": ["performance", "balanced", "power-saver"],
     "label": "Quiet: power profile", "tags": ["modes", "quiet", "power"], "help": ""},
    {"key": "modes.quiet.unload_models", "group": "modes", "type": "toggle", "default": true,
     "label": "Quiet: unload AI models", "tags": ["modes", "quiet", "ai"], "help": ""},

    {"key": "apps.auto_reinstall", "group": "apps", "type": "toggle", "default": true,
     "label": "Reinstall default apps on boot", "tags": ["apps"],
     "help": "Turn off to remove any preinstalled app for good."}
  ]
}
